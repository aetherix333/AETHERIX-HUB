LocalPlayer.CharacterAdded:Connect(function(c)
    local h = c:WaitForChild("Humanoid", 8)
    if h then
        h.WalkSpeed = State.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower = State.JumpPower
    end
    if State.GodMode then
        task.wait(0.5)
        maintainGodMode()
    end
end)

UserInputService.JumpRequest:Connect(function()
    if State.InfJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local LastNoclipTick = 0
RunService.Stepped:Connect(function()
    local now = os.clock()

    if State.Noclip and now - LastNoclipTick >= 0.10 then
        LastNoclipTick = now
        local c = char()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
    end

    if State.GodMode then
        maintainGodMode()
    end
end)

LocalPlayer.Idled:Connect(function()
    if State.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

GuiService.ErrorMessageChanged:Connect(function()
    if State.Master247 or State.AutoDungeon or State.AutoStage then
        task.wait(3)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end)

