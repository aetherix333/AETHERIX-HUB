local CurrentWindUI = nil
local CurrentWindow = nil
local function notify(title, content, icon)
    if CurrentWindUI then
        pcall(function()
            CurrentWindUI:Notify({ Title = title, Content = content, Icon = icon or "bell", Duration = 3 })
        end)
    end
end

