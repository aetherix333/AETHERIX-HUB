    if State.AutoForge then call("Forge", "ForgeRF") end
    if State.AutoEquipBest then call("Backpack", "TryEquipItemRE") end
    if State.AutoRebirth then
        call("Rebirth", "TryRebirthRE")
        if State.NotifyRebirth then
            local isTH = State.Language == "TH"
            sendWebhook(
                isTH and "เกิดใหม่สำเร็จ (Rebirth Cycle Complete)" or "Rebirth Cycle Complete",
