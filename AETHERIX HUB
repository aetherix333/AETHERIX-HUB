-- ─────────────────────────────────────────────────────────────
-- Networking & Instance Helpers
-- ─────────────────────────────────────────────────────────────
local function getRemote(folder, name)
    if not RemoteRoot then return nil end
    local f = RemoteRoot:FindFirstChild(folder)
    return f and f:FindFirstChild(name) or nil
end

-- Serialize RemoteFunction calls so rapid UI taps/automation cannot
-- overlap InvokeServer requests and leave the feature in a bad state.
local RemoteLocks = {}

local function call(folder, name, ...)
    local r = getRemote(folder, name)
    if not r then
        if State.Debug then warn("[Aetherix] Remote missing:", folder, name) end
        return nil
    end

    local key = folder .. "/" .. name
    local args = { ... }

    if r:IsA("RemoteFunction") then
        if RemoteLocks[key] then
            if State.Debug then warn("[Aetherix] Remote busy:", key) end
            return nil
        end

        RemoteLocks[key] = true
        local ok, res = pcall(function()
            return r:InvokeServer(unpack(args))
        end)
        RemoteLocks[key] = nil
        return ok and res or nil
    end

    local ok, res = pcall(function()
        r:FireServer(unpack(args))
    end)
    return ok and res or nil
end

-- Debounce one-shot UI actions. This prevents double taps and duplicate
-- callbacks from dispatching the same server action multiple times.
local ActionDebounce = {}

local function once(key, cooldown, fn)
    local now = os.clock()
    local last = ActionDebounce[key] or 0
    if now - last < (cooldown or 0.35) then
        return false
    end

    ActionDebounce[key] = now
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok and State.Debug then
            warn("[Aetherix Action Error]:", key, err)
        end
    end)
    return true
end

