            -- ---- card / row machinery
            local order = 0
            local cur, curRows = nil, 0
            local function newCard(withStroke)
                order += 1
                local card = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = C.White, BackgroundTransparency = 0.95, BorderSizePixel = 0,
                    LayoutOrder = order,
                }, page)
                corner(card, 16)
                if withStroke then
                    local cs = stroke(card, C.Accent, 1, 0.4)
                    themed(function() cs.Color = C.Accent end)
                end
                new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)
                return card
            end
            local function getCard()
                if not cur then
                    cur = newCard(false)
                    curRows = 0
                end
                return cur
            end
            local function makeRow(title, desc, rightW)
                local card = getCard()
                local idx = curRows
                curRows += 1
                local row = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, LayoutOrder = idx,
                }, card)
                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center,
                }, row)
                if idx > 0 then
                    new("Frame", {
                        Size = UDim2.new(1, -40, 0, 1), BackgroundColor3 = C.White, BackgroundTransparency = 0.92,
                        BorderSizePixel = 0, LayoutOrder = 0,
                    }, row)
                end
                local main = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 64), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, LayoutOrder = 1,
                }, row)
                local hasDesc = desc ~= nil and tostring(desc) ~= ""
                local tb = new("Frame", {
                    Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -(36 + rightW), 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                }, main)
                new("UIPadding", {
                    PaddingTop = UDim.new(0, hasDesc and 12 or 21), PaddingBottom = UDim.new(0, hasDesc and 12 or 21),
                }, tb)
                new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, tb)
                local tl = new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                    Text = tostring(title or ""), Font = Enum.Font.GothamMedium, TextSize = 17, TextColor3 = C.Text,
                    TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 1,
                }, tb)
                local dl = new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                    Text = hasDesc and tostring(desc) or "", Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = C.Sub,
                    TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 2, Visible = hasDesc,
                }, tb)
                local right = new("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0),
                    Size = UDim2.fromOffset(rightW, 34), BackgroundTransparency = 1,
                }, main)
                return { row = row, main = main, right = right, title = tl, desc = dl }
            end

            local function register(id, obj)
                if id ~= nil then Library.Options[id] = obj end
                return obj
            end
            local function parseArgs(id, o)
                if type(id) == "table" then
                    o = id
                    id = o.Id or o.Title
                end
                return id, (type(o) == "table" and o or {})
            end

            -- ------------------------------------------------------------ Section
            function Tab:AddSection(title)
                order += 1
                local sl = new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = order,
                    Text = "  " .. tostring(type(title) == "table" and (title.Title or "") or title or ""),
                    Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.AccentLight,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, page)
                themed(function() sl.TextColor3 = C.AccentLight end)
                cur = nil
                return { __ui = true }
            end

            -- ----------------------------------------------------------- Paragraph
            function Tab:AddParagraph(a, b)
                local title, desc
                if type(a) == "table" then
                    title, desc = a.Title, (a.Desc or a.Content or a.Description)
                else
                    title = a
                    desc = (type(b) == "table") and (b.Desc or b.Content) or b
                end
                local r = makeRow(title, desc or "", 0)
                r.desc.Visible = true
                local obj = { __ui = true, TitleLabel = r.title, DescLabel = r.desc }
                function obj.Set(s, v)
                    v = argOf(s, v)
                    v = tostring(v == nil and "" or v)
                    if r.desc.Text ~= v then r.desc.Text = v end
                end
                obj.SetContent = obj.Set
                obj.SetDesc = obj.Set
                function obj.SetTitle(s, v)
                    v = tostring(argOf(s, v) or "")
                    if r.title.Text ~= v then r.title.Text = v end
                end
                return obj
            end

            -- -------------------------------------------------------------- Callout
            function Tab:AddCallout(title, desc, kind)
                cur = newCard(true)
                curRows = 0
                local r = makeRow(title, desc or "", 0)
                r.desc.Visible = true
                cur = nil
                local obj = { __ui = true, TitleLabel = r.title, DescLabel = r.desc }
                function obj.Set(s, v)
                    v = tostring(argOf(s, v) or "")
