local function SafeCarryHome(sessionToken, carryUid)
    local character = E.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then
        return false
    end

    local home = SourceStealHome()
    if not home then
        return false
    end

    local started = os.clock()
    local lastPosition = root.Position
    local stuckAt = started

    -- ค่าตาม SafeCarry.Home ของไฟล์แนบ
    local carrySpeedMultiplier = math.clamp(tonumber(T["farmCarrySpeed"]) or 1, 0.8, 1.2)
    local carryHeight = 70
    local climbShare = 0.5

    T["isReturning"] = true
    T["stateTime"] = os.clock()
    T["statusText"] = "[AutoSteal] กำลังกลับบ้าน..."

    pcall(function()
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end)

    while T["alive"] and os.clock() - started < 240 do
        if sessionToken and Kq ~= sessionToken then
            break
        end

        if not T["pureTweenFarm"] and not T["autoFarmLoop"] then
            break
        end

        character = E.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then
            break
        end

        local pos = root.Position

        -- แบบเดียวกับ SafeCarry.Home: ข้าม SeparationLine ก่อน แล้วจึงเข้าจุดบ้าน
        local world = R:FindFirstChild("World") or R:FindFirstChild("__OBJECTS")
        local areas = world and world:FindFirstChild("Areas")
        local separationLine = areas and areas:FindFirstChild("SeparationLine")
        local separationX = (
            separationLine and separationLine:IsA("BasePart")
            and separationLine.Position.X or 552
        ) - 7

        local target
        if pos.X > separationX + 2 then
            -- ทางเข้าบ้านใช้ Z ใกล้ home ก่อน
            target = Vector3.new(separationX, pos.Y, home.Z)
        else
            target = home
        end

        local delta = target - pos
        local horizontal = Vector3.new(delta.X, 0, delta.Z)
        local distance = horizontal.Magnitude

        if target == home and distance < 2.5 then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                humanoid:Move(Vector3.zero, false)
                humanoid:MoveTo(root.Position)
            end)
            T["statusText"] = "[AutoSteal] กลับถึงบ้านแล้ว"
            T["isReturning"] = false
            return true
        end

        local unit = distance > 0.01 and horizontal.Unit or Vector3.zero
        local baseSpeed = math.max(tonumber(humanoid.WalkSpeed) or 16, 16)
        local speed = math.max(baseSpeed * carrySpeedMultiplier, 16)

        -- SafeCarry.Home ยกตัวขึ้นตาม Height ก่อนข้ามสนาม
        local desiredY = home.Y
        if target ~= home and distance > 3 then
            desiredY = home.Y + carryHeight
        end

        local yVelocity = 0
        if math.abs(desiredY - pos.Y) > 1 then
            yVelocity = math.clamp(
                (desiredY - pos.Y) / 0.12,
                -speed * climbShare,
                speed * climbShare
            )
        end

        local horizontalSpeed = math.sqrt(math.max(speed * speed - yVelocity * yVelocity, 0))
        horizontalSpeed = math.min(horizontalSpeed, math.max(distance / 0.05, 8))

        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(
                unit.X * horizontalSpeed,
                yVelocity,
                unit.Z * horizontalSpeed
            )
            root.AssemblyAngularVelocity = Vector3.zero
            humanoid:Move(unit, false)
            humanoid:MoveTo(pos + unit * math.min(distance, 30))
        end)

        if (root.Position - lastPosition).Magnitude > 2 then
            lastPosition = root.Position
            stuckAt = os.clock()
        elseif os.clock() - stuckAt > 1.5 then
            pcall(function()
                humanoid.Jump = true
            end)
            stuckAt = os.clock()
        end

        T["statusText"] = string.format(
            "[AutoSteal] กำลังกลับบ้าน %.0f studs",
            (home - pos).Magnitude
        )

        B.Heartbeat:Wait()
    end

    pcall(function()
        root = E.Character and E.Character:FindFirstChild("HumanoidRootPart")
        humanoid = E.Character and E.Character:FindFirstChildOfClass("Humanoid")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if humanoid then
            humanoid:Move(Vector3.zero, false)
        end
    end)

    T["isReturning"] = false
    return false
end
