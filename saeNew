        if ButterflyCatalog and type(ButterflyCatalog.VelocityAt) == "function" then
            local ok, vel = pcall(ButterflyCatalog.VelocityAt, target.Flight, workspace:GetServerTimeNow())
            if ok and typeof(vel) == "Vector3" and vel.Magnitude > 0.1 then
                lead = vel.Unit * 1.5
            end
        end
        local aimPos = target.Position + lead
        movePlayerToPosition(aimPos, ButterflyState.Speed)
        ButterflyState.Status = string.format("จับ%s | บินอยู่ %d", tierNames[target.Tier] or target.Tier, #active)
    elseif ButterflyState.Mode == "Circle" then
        local now = os.clock()
        ButterflyState.CircleAngle = (ButterflyState.CircleAngle + (ButterflyState.Speed / 25) * math.clamp(now - ButterflyState.CircleAt, 0, 0.1)) % (math.pi * 2)
        ButterflyState.CircleAt = now
        local circlePos = centerPos + Vector3.new(math.cos(ButterflyState.CircleAngle) * 25, 3, math.sin(ButterflyState.CircleAngle) * 25)
        movePlayerToPosition(circlePos, ButterflyState.Speed)
        ButterflyState.Status = string.format("วนรอบพื้นที่บลูม | บินอยู่ %d", #active)
    else -- Patrol
        movePlayerToPosition(centerPos, ButterflyState.Speed)
        ButterflyState.Status = string.format("ลาดตระเวนพื้นที่บลูม | บินอยู่ %d", #active)
    end

    -- Swing net when near
    if net and os.clock() - ButterflyState.LastSwing >= ButterflyState.SwingGap then
        ButterflyState.LastSwing = os.clock()
        pcall(function()
            net:Activate()
        end)
    end

    executeButterflyTrades()
    executeButterflyCraft()
end

