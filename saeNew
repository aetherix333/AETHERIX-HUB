                                adorneePart = Instance.new("Part")
                                adorneePart.Name = "ESPRef_" .. tostring(uid)
                                adorneePart.Size = Vector3.new(1, 1, 1)
                                adorneePart.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
