    local function EventSave() local ok,d=pcall(saveData); return ok and type(d)=="table" and d or {} end
    local function EventPlaced()
        local out={}
        if r and type(r.ReadOwnerEggs)=="function" then local ok,d=pcall(r.ReadOwnerEggs,E.UserId); if ok and type(d)=="table" then for uid,v in pairs(d) do if type(v)=="table" and v.Placement~=nil then out[tostring(uid)]=true end end end end
        return out
    end
    local function EventChooseEgg()
        local data=EventSave(); local inv=data.EggInventory or {}; local placed=EventPlaced(); local best,bscore=nil,-math.huge
        for uid,egg in pairs(inv) do if type(egg)=="table" and egg.AssetCategory and not placed[tostring(uid)] then
            local info=getAssetInfo(egg.AssetCategory) or {}; local rar=info.Rarity; local rank=type(rar)=="table" and tonumber(rar.RarityNumber or rar.Rank) or 0
            local income=(tonumber(info.EarningRate) or 0)*(tonumber(egg.AssetScale) or 0)^1.85
            local skip=rank<(EventDrState._minRarity or 0) or income<(EventDrState.MinMutationValue or 0)
            if next(EventDrState.MutationTargetEggs or {}) and not EventDrState.MutationTargetEggs[tostring(egg.AssetCategory)] then skip=true end
            local base=tostring(egg.BaseMutation or ""); if base=="Scrambled" then skip=true end
            if not skip then local score=EventDrState.MutationPriority=="Highest Rarity" and rank*100000+(tonumber(egg.AssetScale) or 0) or (EventDrState.MutationPriority=="Biggest Size" and (tonumber(egg.AssetScale) or 0) or income); if score>bscore then bscore=score; best=egg; best.Uid=uid end end
        end end
        return best
    end
    local function EventScrambledTool()
        for _,container in ipairs({E.Character,E:FindFirstChildOfClass("Backpack")}) do if container then for _,t in ipairs(container:GetChildren()) do if t:IsA("Tool") and (t:GetAttribute("MutationId")=="Scrambled" or string.lower(t.Name):find("scrambled",1,true)) then return t end end end end
    end
    local function EventBuyScrambled()
        local ok,snap=EventInvoke("RF/Scramble/Request","Snapshot"); if not ok or type(snap)~="table" then return false end
        snap=snap.Snapshot or snap; local state=type(snap.State)=="table" and snap.State or snap
        for _,item in ipairs(type(snap.Shop)=="table" and snap.Shop or {}) do if item.Id=="MutationConsumable" then local price=tonumber(item.Price) or math.huge; if (tonumber(state.Samples) or 0)-price<(EventDrState.KeepSamples or 0) then return false end; local ok2,res=EventInvoke("RF/Scramble/Request","Shop",item.Id,{Quote=item.Quote,Sequence=tonumber(state.ShopSequence) or 0}); return ok2 and type(res)=="table" and res.Ok==true end end
        return false
    end
    local function EventMutationStep()
        if not EventDrState.UseScrambledMutation then return end
        local tool=EventScrambledTool(); if not tool and EventDrState.BuyScrambled then EventBuyScrambled(); tool=EventScrambledTool() end
        if not tool then EventDrState.MutationStatus="ต้องมีไอเทม Scrambled"; return end
        local egg=EventChooseEgg(); if not egg then EventDrState.MutationStatus="ไม่มีไข่ตรงตามตัวกรอง"; return end
        if not EventEquip(tool) then EventDrState.MutationStatus="ถือ Scrambled ไม่ได้"; return end
        EventDrState.Tries+=1; EventDrState.MutationStatus="กำลังใช้ Scrambled"
        local ok,res=EventInvoke("RF/BossMastery/AskUseMutationConsumable",egg.Uid)
        if ok and type(res)=="table" and res.Success==true then EventDrState.Applied+=1; EventDrState.MutationStatus="ใช้ Scrambled สำเร็จ" else EventDrState.MutationStatus=(type(res)=="table" and tostring(res.Message or "Try failed")) or "Try failed" end
    end
    local function EventLabStep()
        local ok,state=EventInvoke("RF/ScrambleTradeIn/AskState"); if not ok or type(state)~="table" then EventDrState.LabStatus="ดูสถานะแล็บไม่ได้"; return end
        if state.Unlocked==false then EventDrState.LabStatus="แล็บยังล็อกอยู่ในบัญชีนี้"; return end
        if state.PendingReward~=nil and state.PendingReward~=false then local ok2=EventInvoke("RF/ScrambleTradeIn/AskFinishReveal"); EventDrState.LabStatus=ok2 and "Reward claimed" or "Reward claim failed"; return end
        local req=state.Requirements; if type(req)~="table" or #req==0 then EventDrState.LabStatus="สูตรยังไม่พร้อม"; return end
        local inv=EventSave().EggInventory or {}; local placed=EventPlaced(); local chosen={}; local used={}
        for i,need in ipairs(req) do for uid,egg in pairs(inv) do if not used[tostring(uid)] and not placed[tostring(uid)] and type(egg)=="table" and tostring(egg.AssetCategory)==tostring(need) then chosen[#chosen+1]=uid; used[tostring(uid)]=true; break end end end
        if #chosen<#req then EventDrState.LabStatus="ไข่ไม่ครบตามสูตร"; return end
        local ok2,res=EventInvoke("RF/ScrambleTradeIn/AskTradeIn",chosen); if ok2 and res~=false then EventDrState.LabStatus="ส่งคำสั่งแลกแล้ว" else EventDrState.LabStatus="Trade rejected" end
    end
    local function EventShopStep()
        local ok,snap=EventInvoke("RF/Scramble/Request","Snapshot"); if not ok or type(snap)~="table" then return end
        snap=snap.Snapshot or snap; local state=type(snap.State)=="table" and snap.State or snap; local samples=tonumber(state.Samples) or 0
        for _,item in ipairs(type(snap.Shop)=="table" and snap.Shop or {}) do if EventDrState.ScrambleShopItems[item.Label or item.Id] then local price=tonumber(item.Price) or math.huge; if samples-price>=(EventDrState.KeepSamples or 0) then local ok2,res=EventInvoke("RF/Scramble/Request","Shop",item.Id,{Quote=item.Quote,Sequence=tonumber(state.ShopSequence) or 0}); if ok2 and type(res)=="table" and res.Ok==true then samples-=price end end end end
        EventDrState.Samples=samples
    end

