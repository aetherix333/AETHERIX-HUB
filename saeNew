local function butterflyBloomStep()
    if not ButterflyState.Enabled then return end
    if not isButterflyBloomLive() then
        ButterflyState.Status = "รอผีเสื้อบลูมรอบถัดไป"
        return
    end

    claimButterflyNetIfNeeded()
