local function parsePosition(lcf)
    if typeof(lcf) == "CFrame" then
        return lcf.Position
    elseif typeof(lcf) == "Vector3" then
        return lcf
    elseif type(lcf) == "string" then
        local parts = string.split(lcf, ",")
        if #parts >= 3 then
            local x = tonumber(parts[1])
            local y = tonumber(parts[2])
            local z = tonumber(parts[3])
            if x and y and z then return Vector3.new(x, y, z) end
        end
    elseif type(lcf) == "table" then
        if lcf.Position then return lcf.Position
        elseif lcf.X and lcf.Y and lcf.Z then return Vector3.new(lcf.X, lcf.Y, lcf.Z)
        elseif lcf[1] and lcf[2] and lcf[3] then return Vector3.new(lcf[1], lcf[2], lcf[3])
        end
    end
    return nil
end

local function unplacedEggs()
    local list = {}
    local seen = {}

    -- 1. Check tools in character and backpack
    local char = E and E.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if Uq(item) then
                local uid = item:GetAttribute("UID") or item:GetAttribute("EggUid") or item.Name
                if uid and not seen[uid] then
                    seen[uid] = true
                    table.insert(list, { uid = tostring(uid), cat = item:GetAttribute("Category") or item.Name })
                end
            end
        end
    end
    local bp = E and E:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if Uq(item) then
                local uid = item:GetAttribute("UID") or item:GetAttribute("EggUid") or item.Name
                if uid and not seen[uid] then
                    seen[uid] = true
                    table.insert(list, { uid = tostring(uid), cat = item:GetAttribute("Category") or item.Name })
                end
            end
        end
    end

    -- 2. Check saveData().EggInventory
    local data = saveData()
    local inv = data and data.EggInventory or {}
    for uid, rec in pairs(inv) do
        if type(rec) == "table" and not rec.Placement and not seen[uid] then
            seen[uid] = true
            table.insert(list, {
                uid = tostring(uid),
                cat = rec.AssetCategory or "Egg",
                rarity = tostring(rec.Rarity or "Common"),
                price = tonumber(rec.Price or 0)
            })
        end
    end

    -- 3. Check EggState.ReadOwnedEggs()
    if r and r.ReadOwnedEggs then
        local ok, owned = pcall(r.ReadOwnedEggs)
        if ok and type(owned) == "table" then
            for _, group in pairs(owned) do
                if group.OwnerUserId == E.UserId then
                    for uid, rec in pairs(group.Records or {}) do
                        if type(rec) == "table" and not rec.Placement and not seen[uid] then
                            seen[uid] = true
                            table.insert(list, {
                                uid = tostring(uid),
                                cat = rec.AssetCategory or "Egg",
                                rarity = tostring(rec.Rarity or "Common")
                            })
                        end
                    end
                end
            end
        end
    end

    return list
end

local function occupiedSpots()
    local spots = {}

    -- Primary: EggState.ReadOwnedEggs
    if r and r.ReadOwnedEggs then
        local ok, owned = pcall(r.ReadOwnedEggs)
        if ok and type(owned) == "table" then
            for _, group in pairs(owned) do
                if group.OwnerUserId == E.UserId then
                    for _, rec in pairs(group.Records or {}) do
                        if type(rec) == "table" and rec.Placement and rec.Placement.LocalCFrame then
                            local pos = parsePosition(rec.Placement.LocalCFrame)
                            if pos then table.insert(spots, pos) end
                        end
                    end
                end
            end
            if #spots > 0 then return spots end
        end
    end

    -- Fallback 1: Live snapshot from K remote (AskLiveSnapshot)
    if K then
        local ok, snap = pcall(function() return K:InvokeServer() end)
        if ok and type(snap) == "table" then
            for _, plotData in pairs(snap) do
                if type(plotData) == "table" and (plotData.OwnerUserId == E.UserId or tostring(plotData.OwnerUserId) == tostring(E.UserId)) then
                    for _, rec in pairs(plotData.Records or {}) do
                        if type(rec) == "table" and rec.Placement and rec.Placement.LocalCFrame then
                            local pos = parsePosition(rec.Placement.LocalCFrame)
                            if pos then table.insert(spots, pos) end
                        end
                    end
                end
            end
            if #spots > 0 then return spots end
        end
    end

    -- Fallback 2: saveData EggInventory
    local data = saveData()
    local inv = data and data.EggInventory or {}
    for uid, rec in pairs(inv) do
        if type(rec) == "table" and rec.Placement and rec.Placement.LocalCFrame then
            local pos = parsePosition(rec.Placement.LocalCFrame)
            if pos then table.insert(spots, pos) end
        end
    end
    return spots
end

local function nextFreeSpot(taken)
    local plot, pen, origin = BG()
    local pa = pen
    if not pa or not origin then return nil end
    local center = origin.CFrame
    local halfX = math.max((pa.Size.X or 20) * 0.5 - 4, 2)
    local halfZ = math.max((pa.Size.Z or 20) * 0.5 - 4, 2)
    local spacing = 4.5
    for radius = 0, math.max(halfX, halfZ), spacing do
        for dx = -radius, radius, spacing do
            for dz = -radius, radius, spacing do
                if math.abs(dx) == radius or math.abs(dz) == radius or radius == 0 then
                    if math.abs(dx) <= halfX and math.abs(dz) <= halfZ then
                        local world = pa.CFrame * CFrame.new(dx, 0, dz)
                        local flat  = CFrame.new(world.Position.X, pa.CFrame.Position.Y, world.Position.Z)
                        local lcf   = center:ToObjectSpace(flat)
                        local free  = true
                        for _, p in ipairs(taken or {}) do
                            if (Vector3.new(p.X, 0, p.Z) - Vector3.new(lcf.X, 0, lcf.Z)).Magnitude < spacing - 0.5 then
                                free = false break
                            end
                        end
                        if free then return lcf end
                    end
                end
            end
        end
    end
    return nil
end

local function placeEggs()
    local unplaced = unplacedEggs()
    if #unplaced == 0 then return 0 end

    -- Approach plot if far away
    local plot, pen, origin = BG()
    local char = E and E.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local movedToPen = false

    if pen and root then
        if (root.Position - pen.Position).Magnitude > 25 then
            if Nav.onTreadmill() then Nav.leaveTreadmill() end
            root.CFrame = CFrame.new(root.Position.X, 70, root.Position.Z)
            root.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.04)
            root.CFrame = pen.CFrame + Vector3.new(0, 3.5, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.2)
            movedToPen = true
        end
    end

    local taken = occupiedSpots()
    local placed = 0
    local closeFails, otherFails = 0, 0
    for _, egg in ipairs(unplaced) do
        if #taken >= 15 then break end
        local lcf = nextFreeSpot(taken)
        if not lcf then break end

        local ok, res = false, nil
        if r and r.PlantEgg then
            ok, res = pcall(r.PlantEgg, egg.uid, lcf)
        elseif A then
            ok, res = pcall(function() return A:InvokeServer({ Uid = egg.uid, LocalCFrame = lcf }) end)
        end

        if ok and res ~= false then
            placed = placed + 1
            closeFails, otherFails = 0, 0
            table.insert(taken, lcf.Position)
            task.wait(0.08)
        else
            table.insert(taken, lcf.Position)
            otherFails = otherFails + 1
            if otherFails >= 3 then break end
        end
    end
    if placed > 0 then
        V(string.format("[PlaceEggs] Placed %d eggs", placed))
        saveCache = nil
    end

    -- Return safely to Safe Line (X=525, Y=70, Z=-360) after placing so Auto Steal has a clean start!
    if root and (movedToPen or root.Position.X < 525 or math.abs(root.Position.Z - (T["laneZ"] or -360)) > 20) then
        local safeLaneZ = T["laneZ"] or -360
        root.CFrame = CFrame.new(root.Position.X, 70, root.Position.Z)
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.04)
        root.CFrame = CFrame.lookAt(Vector3.new(525, 70, safeLaneZ), Vector3.new(526, 70, safeLaneZ))
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.04)
    end

    return placed
end

