    if esMod and esMod.ReadFieldEggs then
        local ok, rRes = pcall(esMod.ReadFieldEggs)
        if ok and type(rRes) == "table" then
            allEggs = rRes.Records or rRes
        end
    end

    -- Fallback: AskFieldEggSnapshot RF (server round-trip, use only when EggState unavailable)
    if not allEggs or (type(allEggs) == "table" and next(allEggs) == nil) then
        local snapRF = (i and i["EggWorld"] and i["EggWorld"]["AskFieldEggSnapshot"])
            or h:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot", true)
            or h:FindFirstChild("AskFieldEggSnapshot", true)
        if snapRF and snapRF:IsA("RemoteFunction") then
            pcall(function()
                local snap = snapRF:InvokeServer()
                if type(snap) == "table" then
                    allEggs = snap.Records or snap
