        ButterflyState.TargetColor = tierNames[target.Tier] or target.Tier
    else
        ButterflyState.TargetColor = "ค้นหาผีเสื้อ..."
    end

    if ButterflyState.Mode == "Stand Still" then
        movePlayerToPosition(centerPos + Vector3.new(0, 3, 0), ButterflyState.Speed)
        ButterflyState.Status = string.format("ยืนรอในพื้นที่บลูม | บินอยู่ %d", #active)
    elseif ButterflyState.Mode == "Chase" and target then
