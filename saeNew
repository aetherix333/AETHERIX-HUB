    local function buildDynamicZonesList()
        local zoneList = {"All (ทุกโซน)"}
        local seen = {["All (ทุกโซน)"] = true}
        pcall(function()
            local rep = game:GetService("ReplicatedStorage")
            local mod = rep:FindFirstChild("Data") and rep.Data:FindFirstChild("Areas") and require(rep.Data.Areas)
            if mod and type(mod.Directory) == "table" then
                local areaEntries = {}
                for key, data in pairs(mod.Directory) do
                    local dName = (type(data) == "table" and data.DisplayName) or tostring(key)
                    local order = (type(data) == "table" and tonumber(data.Order)) or (x[dName] or x[tostring(key)] or 0)
                    table.insert(areaEntries, {name = dName, key = tostring(key), order = order})
                end
                table.sort(areaEntries, function(a, b)
                    if a.order ~= b.order then return a.order < b.order end
                    return a.name < b.name
                end)
                for _, entry in ipairs(areaEntries) do
                    if not seen[entry.name] then
                        seen[entry.name] = true
                        table.insert(zoneList, entry.name)
                    end
                end
            end
        end)
        local fallbacks = {
            "Abyss Ocean",
            "Enchanted Forest",
            "Prehistoric",
            "Lake",
            "Volcano",
            "Angels & Demons",
            "Desert",
            "Forest",
            "Cherry Blossom",
            "Titan Temple",
            "Cosmic",
            "Jungle",
            "Snow"
        }
        for fi = #fallbacks, 1, -1 do
            local z = fallbacks[fi]
            if not seen[z] then
                seen[z] = true
                table.insert(zoneList, z)
            end
        end
        return zoneList
    end

