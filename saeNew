            EventDrState.Status=string.format("Fighting %s | boss %d / %d",phase,math.floor((tonumber(arena:GetAttribute("Health")) or 0)+.5),math.floor((tonumber(arena:GetAttribute("MaxHealth")) or 0)+.5))
