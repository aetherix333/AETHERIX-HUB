    local function liveTimeLeft(v)
        local n = tonumber(v)
        if not n then return nil end
        local rem = n > 1e9 and (n - os.time()) or n
        if rem <= 0 then return nil end
        local h, m = math.floor(rem / 3600), math.floor(rem % 3600 / 60)
        if h >= 24 then return string.format("เหลือ %d วัน %d ชม.", math.floor(h / 24), h % 24) end
        if h > 0 then return string.format("เหลือ %d ชม. %d นาที", h, m) end
        return string.format("เหลือ %d นาที", math.max(m, 1))
    end
    local function liveFormat(res)
        local lines = {}
        local function add(k, v)
            local id, left
            if type(v) == "table" then
                id = v.Id or v.EventId or v.Name or v.Key or v.DisplayName or v.Event or (type(k) == "string" and k) or nil
                left = liveTimeLeft(v.EndsAt or v.EndTime or v.EndsIn or v.TimeLeft or v.Remaining or v.Ends or v.EndAt or v.Expires)
            elseif type(v) == "string" then
                id = v
            end
            if id then lines[#lines + 1] = "• " .. liveEventThai(id) .. (left and ("  (" .. left .. ")") or "") end
        end
        if type(res) == "table" then
            local inner = res.Events or res.Running or res.Items or res.List or res
            if type(inner) == "table" then
                for k, v in pairs(inner) do add(k, v) end
            end
        end
        table.sort(lines)
        return lines
    end
