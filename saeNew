        local content = new("Frame", {
            Position = UDim2.fromOffset(262, 72), Size = UDim2.new(1, -276, 1, -86),
            BackgroundTransparency = 1, ClipsDescendants = true,
        }, shell)

        -- ---- toggle-key binding (ปุ่ม "+" ข้างสวิตช์)
        local binds = {}
        local listening = nil
        connect(UIS.InputBegan, function(inp, gp)
            if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if listening then
                local t = listening
                listening = nil
                if inp.KeyCode == Enum.KeyCode.Escape or inp.KeyCode == Enum.KeyCode.Backspace then
                    t.Key = nil
                else
                    t.Key = inp.KeyCode
                end
                if t.refreshBind then t.refreshBind() end
                return
            end
            if gp then return end
            if inp.KeyCode == Enum.KeyCode.RightShift then
                Window:Toggle()
                return
            end
            for _, t in ipairs(binds) do
                if t.Key and t.Key == inp.KeyCode then t:Set(not t.Value) end
            end
        end)

