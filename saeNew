-- Priority sorting
local tierRanks = { Golden = 4, Purple = 3, Blue = 2, Green = 1 }
local tierNames = { Green = "สีเขียว (Emerald)", Blue = "สีฟ้า (Sapphire)", Purple = "สีม่วง (Amethyst)", Golden = "สีทอง (Radiant)" }

local function pickTargetButterfly(butterflies, rootPos)
    if #butterflies == 0 then return nil end
    local best = nil
    local bestScore = math.huge

    for _, b in ipairs(butterflies) do
        if ButterflyState.Tiers[b.Tier] ~= true then continue end
        local dist = (b.Position - rootPos).Magnitude
        local score = dist
        if ButterflyState.Priority == "Rarest First" then
            local r = tierRanks[b.Tier] or 1
            score = dist - (r * 150)
        elseif ButterflyState.Priority == "Strict Rarity" then
            local r = tierRanks[b.Tier] or 1
            score = (5 - r) * 10000 + dist
        end
        if score < bestScore then
            bestScore = score
            best = b
        end
    end
    return best
end

-- Teleport / Move helper for Butterfly Bloom
local function movePlayerToPosition(targetPos, speed)
    local char = E.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    speed = tonumber(speed) or ButterflyState.Speed or 320
    local currentPos = hrp.Position
    local delta = targetPos - currentPos
    local dist = delta.Magnitude

    if dist <= 8 then
        pcall(function()
            hrp.CFrame = CFrame.new(targetPos, targetPos + hrp.CFrame.LookVector)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        return true
    end

    local step = math.min(dist, speed * 0.05)
    local nextPos = currentPos + (delta.Unit * step)
    pcall(function()
        hrp.CFrame = CFrame.new(nextPos, targetPos)
        hrp.AssemblyLinearVelocity = delta.Unit * math.min(speed, dist / 0.05)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    return dist <= 8
end

