-- [[ AUTO TREADMILL: ANY TREADMILL + AUTO STEAL PAUSE/RESUME ]]
-- Finds any TreadmillBottom/Treadmill model in Workspace.  The treadmill
-- worker is intentionally suspended while AutoSteal is travelling/picking/
-- returning, then resumes automatically after the steal cycle.
-- =========================================================================
T["autoTreadmill"] = T["autoTreadmill"] == true
T["treadmillTarget"] = nil
T["treadmillWasActiveBeforeSteal"] = false
T["stealInProgress"] = false

local function isMyTreadmillPlot(plot)
    if not plot or not plot:IsDescendantOf(workspace) then
        return false
    end

    local myUserId = E and E.UserId
    local myName = E and E.Name
    local myDisplayName = E and E.DisplayName

    -- 1. Prefer PlotState's local-slot resolver.
    if plotState and plotState.ResolveLocalSlot then
        local ok, slot = pcall(plotState.ResolveLocalSlot)
        if ok and slot ~= nil then
            local plotsFolder = (plotState.ResolveFolder and plotState.ResolveFolder())
                or workspace:FindFirstChild("Plots")
                or workspace:FindFirstChild("Homesteads")
            if plotsFolder then
                local localPlot = plotsFolder:FindFirstChild(tostring(slot))
                if localPlot then
                    return plot == localPlot
                end
            end
        end
    end

    -- 2. Check the server's OwnersBySlot state.
    if J and myUserId then
        local ok, state = pcall(function()
            return J:InvokeServer()
        end)
        if ok and type(state) == "table" and type(state.OwnersBySlot) == "table" then
            for slot, owner in pairs(state.OwnersBySlot) do
                if owner == myUserId or tostring(owner) == tostring(myUserId) then
                    local plotsFolder = (plotState and plotState.ResolveFolder and plotState.ResolveFolder())
                        or workspace:FindFirstChild("Plots")
                        or workspace:FindFirstChild("Homesteads")
                    if plotsFolder then
                        local ownedPlot = plotsFolder:FindFirstChild(tostring(slot))
                        if ownedPlot then
                            return plot == ownedPlot
                        end
                    end
                end
            end
        end
    end

    -- 3. Check the plot sign / ownership attributes.
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local label = sign:FindFirstChild("PlayerName", true)
        if label and label:IsA("TextLabel") then
            if label.Text == myName or label.Text == myDisplayName then
                return true
            end
        end
    end

    local ownerUserId = plot:GetAttribute("OwnerUserId")
    local ownerName = plot:GetAttribute("Owner")
    if myUserId and ownerUserId ~= nil then
        return ownerUserId == myUserId or tostring(ownerUserId) == tostring(myUserId)
    end
    if myName and ownerName ~= nil then
        return tostring(ownerName) == tostring(myName)
    end

    return false
end

local function findOwnTreadmill()
    local char = E and E.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position
    local plotsFolder = (plotState and plotState.ResolveFolder and plotState.ResolveFolder())
        or workspace:FindFirstChild("Plots")
        or workspace:FindFirstChild("Homesteads")

    if not plotsFolder then
        return nil
    end

    -- Resolve the local player's plot without using the unsafe BG() fallback.
    local myPlot = nil

    if plotState and plotState.ResolveLocalSlot then
        local ok, slot = pcall(plotState.ResolveLocalSlot)
        if ok and slot ~= nil then
            myPlot = plotsFolder:FindFirstChild(tostring(slot))
        end
    end

    if not myPlot and J then
        local ok, state = pcall(function()
            return J:InvokeServer()
        end)
        if ok and type(state) == "table" and type(state.OwnersBySlot) == "table" then
            local myUserId = E and E.UserId
            for slot, owner in pairs(state.OwnersBySlot) do
                if owner == myUserId or tostring(owner) == tostring(myUserId) then
                    myPlot = plotsFolder:FindFirstChild(tostring(slot))
                    if myPlot then break end
                end
            end
        end
    end

    if not myPlot then
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if isMyTreadmillPlot(plot) then
                myPlot = plot
                break
            end
        end
    end

    -- Never fall back to another player's plot.
    if not myPlot or not isMyTreadmillPlot(myPlot) then
        return nil
    end

    -- Cache only after ownership has been verified.
    T["plot"] = myPlot
    T["tread"] = myPlot:FindFirstChild("TreadmillBottom")

    local treadmill = T["tread"]
    if treadmill and treadmill:IsA("BasePart") then
        return treadmill
    end

    -- If TreadmillBottom is nested, search only inside the owned plot.
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(myPlot:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n == "treadmillbottom" or n:find("treadmill", 1, true) then
                local d = origin and (obj.Position - origin).Magnitude or 0
                if d < bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end

    T["tread"] = best
    return best
end

local function getTreadmillMountCFrame(part)
    if not part then return nil end

    -- Prefer an actual Seat/VehicleSeat inside the treadmill model.
    local container = part.Parent
    if container then
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
                return obj.CFrame * CFrame.new(0, 2.5, 0), obj
            end
        end
    end

    -- Fallback: teleport slightly above the treadmill surface.
    local y = math.max(part.Size.Y * 0.5 + 2.5, 3)
    return part.CFrame * CFrame.new(0, y, 0), part
end

local function teleportToTreadmill(part)
    if not part then return false end
    local char = E and E.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    T["treadmillTarget"] = part
    local targetCF, mountPart = getTreadmillMountCFrame(part)
    if not targetCF then return false end

    -- Do not teleport while an egg steal cycle has priority.
    if T["pureTweenFarm"] or T["autoFarmLoop"] or T["glidingToTarget"]
        or T["securingEgg"] or T["delivering"] or T["isReturning"] then
        return false
    end

    pcall(function()
        hum.Sit = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = targetCF
        task.wait(0.08)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    -- Some treadmill implementations mount through touch detection.
    -- Use it when the executor exposes firetouchinterest; otherwise the
    -- normal server/client seat detection gets the same teleport position.
    pcall(function()
        if firetouchinterest and mountPart and mountPart:IsA("BasePart") then
            firetouchinterest(root, mountPart, 0)
            task.wait(0.03)
            firetouchinterest(root, mountPart, 1)
        end
    end)

    local deadline = os.clock() + 2.5
    while T["alive"] and T["autoTreadmill"] and os.clock() < deadline do
        if T["pureTweenFarm"] or T["autoFarmLoop"] or T["glidingToTarget"]
            or T["securingEgg"] or T["delivering"] or T["isReturning"] then
            return false
        end
        if Nav.onTreadmill() then
            return true
        end
        task.wait(0.08)
    end

    return Nav.onTreadmill()
end

local function autoTreadmillStep()
    if not T["autoTreadmill"] then return end

    -- pureTweenFarm/autoFarmLoop means AutoSteal is enabled, not that a steal
    -- is currently running.  Only the active steal-cycle states pause treadmill.
    if T["stealInProgress"] and (os.clock() - (T["stateTime"] or os.clock()) > 30) then
        T["stealInProgress"] = false
    end
    local stealing = T["stealInProgress"]
        or T["glidingToTarget"] or T["securingEgg"]
        or T["delivering"] or T["isReturning"]

    if stealing then
        if Nav.onTreadmill() then
            T["treadmillWasActiveBeforeSteal"] = true
            Nav.leaveTreadmill()
        end
        return
    end

    if Nav.onTreadmill() then
        T["treadmillWasActiveBeforeSteal"] = false
        return
    end

    local target = T["treadmillTarget"]
    if not target or not target:IsDescendantOf(workspace) then
        target = findOwnTreadmill()
    end
    if target then
        teleportToTreadmill(target)
    end
end

