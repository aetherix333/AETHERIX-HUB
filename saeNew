                        end

                        if not tagData or not tagData.gui or not tagData.gui.Parent then
                            local targetAdornee = (rec.Model and (rec.Model.PrimaryPart or rec.Model:FindFirstChildWhichIsA("BasePart"))) or findEggSlotModel(rec)
                            local adorneePart = nil
