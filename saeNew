local function SourceRunToEgg(targetCFrame, targetUid, sessionToken)
    local character = E.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or not targetCFrame then
        return false
    end

    local targetPosition = targetCFrame.Position
    local targetHeight = targetPosition.Y + 3
    local runHeight = 50
    local runSpeed = math.clamp(tonumber(T["farmTweenSpeed"]) or 1, 0.5, 1.2)
    local started = os.clock()
    local lastPosition = root.Position
    local stuckAt = started

    T["glidingToTarget"] = true
    T["stateTime"] = os.clock()
    T["targetPosition"] = targetPosition

    pcall(function()
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
        if character:FindFirstChildWhichIsA("Tool") then
            humanoid:UnequipTools()
        end
    end)

    while T["alive"] and os.clock() - started < 240 do
        if sessionToken and Kq ~= sessionToken then
            break
        end

        if not T["pureTweenFarm"] and not T["autoFarmLoop"] then
            break
        end

        character = E.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then
            break
        end

        local nowPos = root.Position
        local delta = targetPosition - nowPos
        local horizontal = Vector3.new(delta.X, 0, delta.Z)
        local distance = horizontal.Magnitude

        if distance <= 22 and T["hitCompetitors"] ~= false and type(T["HitNearbyCompetitors"]) == "function" then
            T["HitNearbyCompetitors"](targetPosition, 16)
        end

        if distance <= 3 and math.abs(nowPos.Y - targetHeight) <= 6 then
            pcall(function()
                humanoid:Move(Vector3.zero, false)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                humanoid:UnequipTools()
            end)
            T["statusText"] = "[AutoSteal] ถึงไข่แล้ว"
            T["glidingToTarget"] = false
            return true
        end

        local unit = distance > 0.01 and horizontal.Unit or Vector3.zero

        -- ตรงกับแนวทาง SafeCarry.RunTo:
        -- ใช้ Humanoid.WalkSpeed + RunSpeed และยกตัว RunHeight ระหว่างวิ่งในสนาม
        local baseSpeed = math.max(tonumber(humanoid.WalkSpeed) or 16, 16)
        local speed = math.max(baseSpeed * runSpeed, tonumber(T["farmFlySpeed"]) or 120)

        local yTarget = targetHeight
        if distance > 3 then
            yTarget = targetHeight + runHeight
        end

        local climbShare = 0.5
        local yVelocity = math.clamp(
            (yTarget - nowPos.Y) / 0.12,
            -speed * climbShare,
            speed * climbShare
        )

        local horizontalSpeed = math.sqrt(math.max(speed * speed - yVelocity * yVelocity, 0))
        horizontalSpeed = math.min(horizontalSpeed, math.max(distance / 0.05, 8))

        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(
                unit.X * horizontalSpeed,
                yVelocity,
                unit.Z * horizontalSpeed
            )
            root.AssemblyAngularVelocity = Vector3.zero
            humanoid:Move(unit, false)
        end)

        -- RunStyle = Walk/Velocity ของไฟล์แนบ: มี MoveTo ช่วยรักษาทิศทาง
        if distance > 0.01 then
            pcall(function()
                humanoid:MoveTo(nowPos + unit * math.min(distance, 30))
            end)
        end

        if (root.Position - lastPosition).Magnitude > 2 then
            lastPosition = root.Position
            stuckAt = os.clock()
        elseif os.clock() - stuckAt > 1.5 then
            pcall(function()
                humanoid.Jump = true
            end)
            stuckAt = os.clock()
        end

        T["statusText"] = string.format(
            "[AutoSteal] วิ่งไปหาไข่ %.0f studs",
            distance
        )

        B.Heartbeat:Wait()
    end

    pcall(function()
        root = E.Character and E.Character:FindFirstChild("HumanoidRootPart")
        humanoid = E.Character and E.Character:FindFirstChildOfClass("Humanoid")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if humanoid then
            humanoid:Move(Vector3.zero, false)
        end
    end)

    T["glidingToTarget"] = false
    return false
end


