local RIFT_BANNER_NAMES = {
    Verdant = "Riftborn",
    Umbral  = "Riftbeasts",
    Radiant = "Shattered Rift",
}

local function getRiftState()
    local ok, state = pcall(function()
        local rf = findRemote(NET.Rift.ASK_STATE) or (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking") and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/TheRift/AskState"))
        if rf and rf:IsA("RemoteFunction") then return rf:InvokeServer() end
    end)
    if ok and type(state) == "table" then
        if not state.BannerDisplayName and state.BannerId then
            state.BannerDisplayName = RIFT_BANNER_NAMES[state.BannerId] or state.BannerId
        end
        return state
    end
    return nil
end

local function rerollRiftFree()
    local rf = findRemote(NET.Rift.ASK_REFRESH) or (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking") and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/TheRift/AskRefresh"))
    if rf and rf:IsA("RemoteFunction") then
        local ok, res = pcall(function() return rf:InvokeServer() end)
        if ok and res == true then
            task.wait(0.5)
            local fresh = getRiftState()
            if fresh then Runtime.riftState = fresh end
            return true
        end
    end
    return false
end

local function riftStep(manual)
    if not manual and not Cfg.AutoRift then return false end
    if T["glidingToTarget"] or T["securingEgg"] or T["delivering"] or T["isReturning"] then return false end

    local state = getRiftState()
    if not state or not state.Unlocked then return false end
    Runtime.riftState = state

    local currentBanner = state.BannerDisplayName or RIFT_BANNER_NAMES[state.BannerId] or state.BannerId
    local target = Cfg.RiftTarget or "ทุกประเภท (All)"

    local isMatch = false
    if target == "All" or target == "ทุกประเภท (All)" or target == "All Banners" or target == "" then
        isMatch = true
    else
        local cleanTarget = tostring(target):gsub("%s*%(.-%)", ""):lower()
        local bName = tostring(currentBanner):lower()
        local bId = tostring(state.BannerId or ""):lower()
        if bName:find(cleanTarget, 1, true) or bId:find(cleanTarget, 1, true) or cleanTarget:find(bName, 1, true) then
            isMatch = true
        end
    end

    if not isMatch then
        if (manual or Cfg.RiftAutoReroll) and (state.FreeRefreshesRemaining or 0) > 0 then
            local refreshed = rerollRiftFree()
            if refreshed then
                task.wait(0.8)
                state = getRiftState()
                Runtime.riftState = state
                currentBanner = state and (state.BannerDisplayName or state.BannerId) or currentBanner
            end
        else
            return false
        end
    end

    local reqs = state.Requirements
    if not reqs or type(reqs) ~= "table" or #reqs < 3 then return false end

    local pets = petItems(true)
    local usedUids = {}
    local matchedUids = {}

    for slot = 1, 3 do
        local wantName = tostring(reqs[slot])
        local found = nil
        for _, p in ipairs(pets) do
            if not usedUids[p.uid] and not p.equipped and not p.favorite and not p.inFuse then
                local isBillionTier = (p.rate and p.rate >= 1e9) or (p.price and p.price >= 1e9)
                if not isBillionTier then
                    local pName = tostring(p.cat)
                    if pName == wantName or pName:lower() == wantName:lower() then
                        found = p
                        break
                    end
                end
            end
        end

        if found then
            usedUids[found.uid] = true
            matchedUids[slot] = found.uid
        else
            return false, "ขาดวัตถุดิบ: " .. wantName
        end
    end

    if #matchedUids == 3 then
        local askTrade = findRemote(NET.Rift.ASK_TRADE_IN) or (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking") and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/TheRift/AskTradeIn"))
        if not askTrade then return false, "Remote AskTradeIn not found" end

        local okTrade, resTrade = pcall(function() return askTrade:InvokeServer(matchedUids) end)
        if okTrade and resTrade == true then
            task.wait(0.2)
            local askFinish = findRemote(NET.Rift.ASK_FINISH_REVEAL) or (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking") and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/TheRift/AskFinishReveal"))
            if askFinish then pcall(function() askFinish:InvokeServer() end) end
            Runtime.stats.riftFuses = (Runtime.stats.riftFuses or 0) + 1
            saveCache, petCache = nil, nil
            markSellDirty()
            return true
        else
            return false, tostring(resTrade)
        end
    end
    return false
end

