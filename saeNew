local Network = nil
local remoteCache = {}
local function findRemote(endpoint)
    if not endpoint then return nil end
    local name = tostring(endpoint)
    if remoteCache[name] and remoteCache[name].Parent then
        return remoteCache[name]
    end

    local candidates = { name }
    if REMOTE_MAP[name] then
        table.insert(candidates, 1, REMOTE_MAP[name])
    end

    for _, cname in ipairs(candidates) do
        if NetworkFolder then
            local direct = NetworkFolder:FindFirstChild(cname)
            if direct then
                remoteCache[name] = direct
                return direct
            end
        end
        local found = ReplicatedStorage:FindFirstChild(cname, true)
        if found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
            remoteCache[name] = found
            return found
        end
    end
    return nil
end

if type(Network) ~= "table" then
    Network = {
        Invoke = function(endpoint, ...)
            local inst = findRemote(endpoint)
            if inst and inst:IsA("RemoteFunction") then
                return inst:InvokeServer(...)
            end
            return false, "remote not found"
        end,
        Fire = function(endpoint, ...)
            local inst = findRemote(endpoint)
            if inst and inst:IsA("RemoteEvent") then
                inst:FireServer(...)
            elseif inst and inst:IsA("RemoteFunction") then
                inst:InvokeServer(...)
            end
        end
    }
end

