function ObsidianGlassEngine:CreateWindow(cfg)
    cfg = type(cfg) == "table" and cfg or {}
    local Library = loadPayomboyZLibrary()
    -- ===== ใส่รูปโลโก้ตรงนี้ (ใช้กับลูกลอย + โลโก้มุมซ้ายบนของหน้าต่าง) =====
    -- ตัวอย่าง: local localLogo = "rbxassetid://1234567890"   (เว้นว่าง "" = ใช้ตัวอักษร P)
    local localLogo = "rbxassetid://138186404172062"

    local EngineWindow = Library:CreateWindow({
        Title = "AXOR HUB",
        Name = "เก็บไข่ไปกับแอ็กซอร์",
        Subtitle = "เก็บไข่ไปกับแอ็กซอร์",
        VersionTag = "v5.0.0",
        DefaultTab = "ฟาร์ม",
        Theme = "Crimson",
        Motion = "Full",
        Logo = localLogo,
        Effects = {
            Lightning = true,
            Sparks = true,
            CapsuleSparks = false,
            Sound = true,
            Intro = false,
            SparkCount = 4,
            CapsuleSparkCount = 0,
        },
    })

    -- ====================================================================
    -- RESPONSIVE MOBILE SCALING & ADAPTATION ENGINE
    -- ====================================================================
    local UserInputService = game:GetService("UserInputService")
    local Camera = workspace.CurrentCamera
    local isTouchDevice = UserInputService.TouchEnabled and not (UserInputService.KeyboardEnabled and UserInputService.MouseEnabled)

    local shell = EngineWindow.Shell or (EngineWindow.Gui and EngineWindow.Gui:FindFirstChild("MainShell"))
    local gui = EngineWindow.Gui

    -- Ensure UIScale is attached directly to shell (MainShell Frame)
    local shellScale = shell and shell:FindFirstChildOfClass("UIScale")
    if not shellScale and shell then
        if gui and gui:FindFirstChildOfClass("UIScale") then
            shellScale = gui:FindFirstChildOfClass("UIScale")
            shellScale.Parent = shell
        else
            shellScale = Instance.new("UIScale")
            shellScale.Parent = shell
        end
    end

    local function getAutoFitScale()
        local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
        local isSmallScreen = vp.Y < 560 or vp.X < 960
        local isMobile = isTouchDevice or isSmallScreen
        
        local padX = isMobile and 36 or 24
        local padY = isMobile and 32 or 24
        local availW = math.max(vp.X - padX, 240)
        local availH = math.max(vp.Y - padY, 180)
        
        local scaleX = availW / 920
        local scaleY = availH / 600
        local rawScale = math.min(scaleX, scaleY)
        
        if isMobile then
            -- Mobile phone / small viewport: clamp between 0.38 and 0.85
            return math.clamp(rawScale, 0.38, 0.85)
        else
            -- PC display
            return math.clamp(rawScale, 0.45, 1.0)
        end
    end

    local customScaleOverride = nil
    local function applyScale(target)
        local s = target or customScaleOverride or getAutoFitScale()
        s = math.clamp(s, 0.35, 1.25)
        if shellScale then
            shellScale.Scale = s
        end
        if EngineWindow.SetUIScale then
            pcall(function() EngineWindow:SetUIScale(s) end)
        end
        return s
    end

    -- Initial auto-fit
    applyScale()

    -- Viewport resize / rotation listener
    if Camera then
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if not customScaleOverride then
                applyScale()
            end
        end)
    end

    -- Center window on mobile devices so it never overflows off-screen
    if shell and (isTouchDevice or (Camera and Camera.ViewportSize.Y < 560)) then
        shell.AnchorPoint = Vector2.new(0.5, 0.5)
        shell.Position = UDim2.fromScale(0.5, 0.5)
    end

    local WindowObj = {
        Native = EngineWindow,
        Tabs = {},
        Options = ObsidianGlassEngine.Options,
        Shell = shell,
        Gui = gui,
        IsMobile = isTouchDevice or (Camera and Camera.ViewportSize.Y < 560),
    }

    function WindowObj:SetUIScale(s)
        customScaleOverride = tonumber(s)
        return applyScale(customScaleOverride)
    end

    function WindowObj:SetTheme(n) pcall(function() Library:SetTheme(n) end) end
    function WindowObj:SetTransparency(v) pcall(function() Library:SetTransparency(v) end) end
    function WindowObj:GetThemes() return Library.ThemeNames end
    function WindowObj:GetTheme() return Library.CurrentTheme end
    function WindowObj:GetTransparency() return Library.Transparency end

    function WindowObj:GetUIScale()
        return shellScale and shellScale.Scale or (customScaleOverride or getAutoFitScale())
    end

    function WindowObj:AutoFitScreen()
        customScaleOverride = nil
        return applyScale()
    end

    function WindowObj:Center()
        if shell then
            shell.AnchorPoint = Vector2.new(0.5, 0.5)
            shell.Position = UDim2.fromScale(0.5, 0.5)
        end
    end

    function WindowObj:SetTitle(t)
        pcall(function()
            if EngineWindow.SetTitle then EngineWindow:SetTitle(t) end
        end)
    end

    function WindowObj:SetSubTitle(s)
        pcall(function()
            if EngineWindow.SetSubtitle then EngineWindow:SetSubtitle(s) end
        end)
    end

    function WindowObj:Notify(nCfg)
        pcall(function()
            Library:Notify(nCfg)
        end)
    end

    function WindowObj:Unload()
        pcall(function()
            if EngineWindow.Unload then EngineWindow:Unload()
            elseif EngineWindow.Destroy then EngineWindow:Destroy() end
        end)
    end

