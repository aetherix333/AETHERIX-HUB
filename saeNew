    local function refreshQueueStatus()
        local Q = T["panelQueue"] or {}
        local raw = T["panelTargetList"] or {}
        local present = {}
        for _, it in ipairs(raw) do present[it.Uid] = true end
        for i = #Q, 1, -1 do if not present[Q[i]] then table.remove(Q, i) end end
        local lines = {}
        for i, uid in ipairs(Q) do
            local name = "ไม่ทราบชื่อ"
            for _, it in ipairs(raw) do
                if it.Uid == uid then name = tostring(it.DisplayName or it.Category or "Egg"); break end
            end
            table.insert(lines, string.format("#%d %s", i, name))
            if i >= 5 then table.insert(lines, string.format("...และอีก %d ฟอง", #Q - 5)); break end
        end
        if #Q == 0 then lines = {"ไม่มีไข่ในคิว"} end
        if queueStatusPara and queueStatusPara.Set then
            queueStatusPara:Set(table.concat(lines, "\n"))
        elseif queueStatusPara and queueStatusPara.SetContent then
            queueStatusPara:SetContent(table.concat(lines, "\n"))
        end
    end

