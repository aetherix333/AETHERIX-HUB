                C.Bottom = Color3.new(a.R * 0.045 + 0.012, a.G * 0.045 + 0.012, a.B * 0.045 + 0.016)
                Library.CurrentTheme = name
                return true
            end
        end
        return false
    end
    function Library:SetTheme(name)
        if applyThemeColors(name) then
            for _, fn in ipairs(themedFns) do pcall(fn) end
            saveSettings()
        end
    end
    local saveToken = 0
    function Library:SetTransparency(v)
        v = math.clamp(tonumber(v) or 0.06, 0, 0.95)
        Library.Transparency = v
        for _, sh in ipairs(shells) do
            if sh.Parent then sh.BackgroundTransparency = v end
        end
        saveToken += 1
        local mine = saveToken
        task.delay(0.6, function()
            if mine == saveToken then saveSettings() end
        end)
    end
    do
        local saved = {}
        pcall(function()
            if type(readfile) == "function" and type(isfile) == "function" and isfile(SETTINGS_FILE) then
                saved = game:GetService("HttpService"):JSONDecode(readfile(SETTINGS_FILE))
            end
        end)
        if type(saved) ~= "table" then saved = {} end
        applyThemeColors(saved.theme or "")
        if not C.Top then applyThemeColors(THEMES[1][1]) end
        if tonumber(saved.transparency) then Library.Transparency = math.clamp(saved.transparency, 0, 0.95) end
    end

    -- ---------------------------------------------------------------- helpers
    local function new(class, props, parent)
        local o = Instance.new(class)
        if props then
            for k, v in pairs(props) do o[k] = v end
        end
        if parent then o.Parent = parent end
        return o
    end
    local function corner(p, r)
        return new("UICorner", { CornerRadius = UDim.new(0, r) }, p)
    end
    local function stroke(p, color, thick, transp)
        return new("UIStroke", {
            Color = color, Thickness = thick or 1, Transparency = transp or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, p)
    end
    local function tween(o, t, props)
        local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end
    local function safe(cb, ...)
        if type(cb) == "function" then
            local ok, err = pcall(cb, ...)
            if not ok then warn("[UI] callback error: " .. tostring(err)) end
        end
    end
    -- รองรับทั้ง obj:Set(v) และ obj.Set(v)
    local function argOf(a, b)
        if type(a) == "table" and rawget(a, "__ui") then return b end
        return a
    end
    local function mountGui(g)
        local ok = pcall(function()
            if type(gethui) == "function" then
                g.Parent = gethui()
            else
                g.Parent = game:GetService("CoreGui")
            end
        end)
        if not ok or not g.Parent then
            g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
        end
    end

    -- ------------------------------------------------- line icons (ไม่ใช้อิโมจิ)
    local function drawIcon(parent, name)
        local holder = new("Frame", {
            Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1,
        }, parent)
        local paints = {}
        local function ring(x, y, w, h, round, rot)
            local f = new("Frame", {
                Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
                BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = rot or 0,
            }, holder)
            if round == true then
                new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
            elseif round then
                corner(f, round)
            end
            local st = stroke(f, C.Sub, 2, 0)
            table.insert(paints, function(c) st.Color = c end)
            return f
        end
        local function solid(x, y, w, h, round, rot)
            local f = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x + w / 2, y + h / 2),
                Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.Sub, BorderSizePixel = 0, Rotation = rot or 0,
            }, holder)
            if round then corner(f, round) end
            table.insert(paints, function(c) f.BackgroundColor3 = c end)
            return f
        end
        local n = tostring(name or "")
        if n == "egg" then
            ring(6, 3, 12, 17, true)
        elseif n == "package" or n == "coins" then
            ring(4, 6, 16, 14, 3)
            solid(4, 11, 16, 2)
            solid(11, 6, 2, 5)
        elseif n == "flame" or n == "calendar-days" then
            ring(3, 5, 18, 16, 3)
            solid(3, 10, 18, 2)
            solid(7, 2, 2, 5, 1)
            solid(15, 2, 2, 5, 1)
        elseif n == "trophy" or n == "trending-up" then
            ring(6, 3, 12, 10, 5)
            solid(11, 13, 2, 4)
            solid(7, 18, 10, 2, 1)
            ring(1, 5, 4, 5, 2)
            ring(19, 5, 4, 5, 2)
        elseif n == "player" or n == "user" then
            ring(8, 3, 8, 8, true)
            ring(4, 14, 16, 8, 7)
        elseif n == "settings" or n == "layout-dashboard" then
            ring(6, 6, 12, 12, true)
            for i = 0, 7 do
                local a = math.rad(i * 45)
                solid(12 + math.sin(a) * 9.5 - 1.5, 12 - math.cos(a) * 9.5 - 2.5, 3, 5, 1, i * 45)
            end
        else
            ring(7, 7, 10, 10, 2, 45)
        end
        local function paint(c)
            for _, f in ipairs(paints) do f(c) end
        end
        paint(C.Sub)
        return paint
    end

