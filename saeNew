    local FarmFavoriteState = {
        Enabled = false,
        MinRarity = 0,
        Species = {},
        AlwaysEquipped = false,
        UnfavoriteEquipped = false,
    }
    local function FarmFavoriteApply()
        if not FarmFavoriteState.Enabled and not FarmFavoriteState.AlwaysEquipped and not FarmFavoriteState.UnfavoriteEquipped then return end
        task.spawn(function()
            pcall(function()
                local writeFav = h:FindFirstChild("RE/PetSatchel/WriteFavourite", true)
                if not writeFav then return end
                local pets = petItems and petItems(true)
                if not pets then return end
                for _, pet in ipairs(pets) do
                    local petUid = pet.uid or pet.Uid or pet.Id
                    local isEquipped = pet.equipped == true or pet.Equipped == true
                    local speciesName = tostring(pet.cat or pet.species or "")
                    local rank = 0
                    if RARITY_ORDER and pet.rarity then
                        for i, rname in ipairs(RARITY_ORDER) do
                            if tostring(rname) == tostring(pet.rarity) then rank = i break end
                        end
                    end

                    local shouldFav = nil
                    if FarmFavoriteState.AlwaysEquipped and isEquipped then
                        shouldFav = true
                    elseif FarmFavoriteState.UnfavoriteEquipped and isEquipped then
                        shouldFav = false
                    elseif FarmFavoriteState.Enabled then
                        if FarmFavoriteState.MinRarity > 0 and rank >= FarmFavoriteState.MinRarity then
                            shouldFav = true
                        elseif FarmFavoriteState.Species and FarmFavoriteState.Species[speciesName] then
                            shouldFav = true
                        end
                    end

                    if petUid and shouldFav ~= nil and pet.favorite ~= shouldFav then
                        pcall(function()
                            writeFav:FireServer(petUid, shouldFav)
                        end)
                        pet.favorite = shouldFav
                        task.wait(0.02)
                    end
                end
            end)
        end)
    end

