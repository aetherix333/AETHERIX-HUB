                            end

                            local badgeLbl = Instance.new("TextLabel")
                            badgeLbl.Size = UDim2.new(1, 0, 0, 12)
                            badgeLbl.Position = UDim2.new(0, 0, 0, 16)
                            badgeLbl.BackgroundTransparency = 1
                            badgeLbl.Text = badgeText
                            badgeLbl.TextColor3 = (scale >= 1.5 and Color3.fromRGB(255, 200, 50)) or Color3.fromRGB(215, 215, 225)
                            badgeLbl.Font = Enum.Font.GothamMedium
                            badgeLbl.TextSize = 9
                            badgeLbl.TextXAlignment = Enum.TextXAlignment.Left
                            badgeLbl.Parent = infoFrame

                            -- Row 3: Income/s + Distance
