        dot(Color3.fromRGB(254, 188, 46), -50, function() Window:Toggle() end)
        dot(Color3.fromRGB(40, 200, 64), -18, function()
            normalSize = not normalSize
            tween(shell, 0.2, { Size = normalSize and UDim2.fromOffset(920, 600) or UDim2.fromOffset(700, 480) })
        end)

        -- ---- dragging
        do
            local dragging, startPos, startInput = false, nil, nil
            titleBar.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    startInput = inp.Position
                    startPos = shell.Position
                end
            end)
            connect(UIS.InputChanged, function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    local d = inp.Position - startInput
                    local s = math.max(uiScale.Scale, 0.01)
