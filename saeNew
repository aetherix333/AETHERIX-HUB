SourceReturnHome = function(sessionToken, carryUid)
    -- callers pass only the session token, so find which egg is being carried
    if type(carryUid) ~= "string" then
        if r and type(r.ReadCarryState) == "function" then
            local ok, st = pcall(r.ReadCarryState)
            if ok and type(st) == "table" and st.IsCarrying == true and type(st.Uid) == "string" then
                carryUid = st.Uid
            end
        end
    end
    if type(carryUid) ~= "string" then
        local _, uidChar = zq()
        if type(uidChar) ~= "string" then
            local _, uidBag = tq()
            uidChar = uidBag
        end
        carryUid = uidChar
        -- [fix] the carried egg may not be a Tool (zq/tq find nothing) -> read the UID from EggState,
        -- otherwise LineDropHome exits at its first check and the script falls back to walking home
        if type(carryUid) ~= "string" and r and type(r["ReadFieldEggs"]) == "function" then
            local okF, dF = pcall(r["ReadFieldEggs"])
            if okF and type(dF) == "table" and type(dF["Records"]) == "table" then
                for _, rec in pairs(dF["Records"]) do
                    if type(rec) == "table" and type(rec["Uid"]) == "string"
                        and (rec["State"] == "Carried" or rec["State"] == 2)
                        and (rec["CarrierUserId"] or rec["Carrier"]) == E.UserId then
                        carryUid = rec["Uid"]
                        break
                    end
                end
            end
        end
    end
    if SafeCarry.LineDrop and not T["_inLineDrop"] and type(SafeCarry.LineDropHome) == "function" then
        local okLD, doneLD = pcall(SafeCarry.LineDropHome, sessionToken, carryUid)
        if okLD and doneLD == true then return true end
        -- Line Drop failed -> fall back to SafeCarry.Home
        T["_inLineDrop"] = false
        T["statusText"] = "Line Drop failed - falling back to SafeCarry.Home"
        local c0 = E.Character
        if not (c0 and c0:FindFirstChild("HumanoidRootPart")) then return false end
    end
    return SafeCarry.Home(sessionToken, carryUid)
end

