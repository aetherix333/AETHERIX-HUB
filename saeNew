local function findEggSlotModel(rec)
    local nestId = rec.NestId
    local areaId = rec.AreaId
    local cf = rec.BottomCFrame or rec.BoundsCFrame
    local pos = cf and cf.Position
    local slotsFolder = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slotsFolder then
        if nestId and areaId then
            for _, m in ipairs(slotsFolder:GetChildren()) do
                local name = m.Name
                if name:find(nestId, 1, true) and name:find(areaId, 1, true) then
                    return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart") or m
                end
            end
        end
        if pos then
            for _, m in ipairs(slotsFolder:GetChildren()) do
                local part = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                if part and (part.Position - pos).Magnitude <= 5 then
                    return part
                end
            end
        end
    end
    return nil
end

local function updateEggESP()
    if not Cfg_EggESP then
        if next(espTags or {}) then clearEggESP() end
        return
    end

    local folder = getESPFolder()
    local liveUids = {}
    local char = E and E.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
    local myPos = root and root.Position or Vector3.zero

    -- Fetch all raw field egg records
    -- Priority: EggState.ReadFieldEggs (fastest, client-side) → AskFieldEggSnapshot RF
    local allEggs = nil

    -- Try EggState module (re-resolve if global r is nil)
    local esMod = r
    if not esMod or not esMod.ReadFieldEggs then
        pcall(function()
            local esInst = h:FindFirstChild("EggState", true)
            if esInst then
                esMod = require(esInst)
            end
        end)
        if esMod then r = esMod end  -- cache back into global r
