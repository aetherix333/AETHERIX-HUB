                                statLbl = statLbl,
                                petImg = petImg,
                                income = income
                            }
                        else
                            if tagData.petImg and info and info.Icon and tagData.petImg.Image ~= info.Icon then
                                tagData.petImg.Image = info.Icon
                            end
                            if tagData.statLbl then
                                local incStr = formatIncomeStr(tagData.income)
                                tagData.statLbl.Text = (incStr ~= "" and string.format("%s • %dm", incStr, dist)) or string.format("%dm", dist)
                            end
                        end
                    end
                end
            end
        end
    end

    for uid, tagData in pairs(espTags) do
        if not liveUids[uid] then
            pcall(function()
                if tagData.gui then tagData.gui:Destroy() end
                if tagData.refPart then tagData.refPart:Destroy() end
            end)
            espTags[uid] = nil
        end
    end
end

