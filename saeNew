                themed(function() render(false) end)
                return register(id, obj)
            end

            -- --------------------------------------------------------------- Slider
            function Tab:AddSlider(id, o)
                id, o = parseArgs(id, o)
                local minV, maxV = tonumber(o.Min) or 0, tonumber(o.Max) or 100
                if maxV <= minV then maxV = minV + 1 end
                local rounding = tonumber(o.Rounding) or 0
                local r = makeRow(o.Title, o.Desc or o.Description, 240)
                local obj = { __ui = true, Id = id, Type = "Slider" }

                local mult = 10 ^ rounding
                local function norm(v)
                    v = math.clamp(tonumber(v) or minV, minV, maxV)
                    return math.floor(v * mult + 0.5) / mult
                end
                obj.Value = norm(o.Default ~= nil and o.Default or (o.Value ~= nil and o.Value or minV))

                local valLbl = new("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -160, 0.5, 0),
                    Size = UDim2.new(0, 70, 0, 20), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
                    TextSize = 13, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Right, Text = "",
                }, r.right)
                local track = new("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(140, 4), BackgroundColor3 = C.TrackOff, BorderSizePixel = 0,
                }, r.right)
                corner(track, 2)
                local fill = new("Frame", {
                    Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Accent, BorderSizePixel = 0,
                }, track)
                corner(fill, 2)
                themed(function() fill.BackgroundColor3 = C.Accent end)
                local knob = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                    Size = UDim2.fromOffset(22, 22), BackgroundColor3 = C.White, BorderSizePixel = 0, ZIndex = 2,
                }, track)
                corner(knob, 11)
                local hit = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.new(1, 30, 0, 38), BackgroundTransparency = 1, Active = true, ZIndex = 3,
                }, track)

                local function render()
                    local a = (obj.Value - minV) / (maxV - minV)
                    fill.Size = UDim2.fromScale(a, 1)
                    knob.Position = UDim2.fromScale(a, 0.5)
                    valLbl.Text = string.format("%." .. tostring(math.max(rounding, 0)) .. "f", obj.Value)
                end
                function obj.Set(s, v)
                    v = norm(argOf(s, v))
                    local changed = (v ~= obj.Value)
                    obj.Value = v
                    render()
                    if changed then safe(o.Callback, obj.Value) end
                end
                obj.SetValue = obj.Set
                function obj.Get() return obj.Value end

                local dragging = false
                local function fromX(x)
                    local w = math.max(track.AbsoluteSize.X, 1)
                    local rel = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
                    obj:Set(minV + rel * (maxV - minV))
                end
                hit.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        page.ScrollingEnabled = false
                        fromX(inp.Position.X)
                    end
                end)
                connect(UIS.InputChanged, function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        fromX(inp.Position.X)
                    end
                end)
                connect(UIS.InputEnded, function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        page.ScrollingEnabled = true
                    end
                end)
                render()
                return register(id, obj)
            end

            -- ------------------------------------------------------------- Dropdown
            function Tab:AddDropdown(id, o)
                id, o = parseArgs(id, o)
                local multi = (o.Multi == true)
                local r = makeRow(o.Title, o.Desc or o.Description, 176)
                local obj = { __ui = true, Id = id, Type = "Dropdown" }
                local values = {}
                for _, v in ipairs(o.Values or {}) do table.insert(values, v) end
                local sel = {}
                local open = false

                local function setSelFrom(v)
                    sel = {}
                    if multi then
                        if type(v) == "table" then
                            for _, x in ipairs(v) do sel[x] = true end
                            for k, x in pairs(v) do
                                if type(k) ~= "number" and x == true then sel[k] = true end
                            end
                        elseif v ~= nil and v ~= "" then
                            sel[v] = true
                        end
                    else
                        if type(v) == "table" then v = v[1] end
                        obj.Value = v
                    end
                end
                local function rebuildValue()
                    if not multi then return end
                    local arr, seen = {}, {}
                    for _, v in ipairs(values) do
                        if sel[v] then
                            table.insert(arr, v)
                            seen[v] = true
                        end
                    end
                    for k in pairs(sel) do
                        if not seen[k] then table.insert(arr, k) end
                    end
                    obj.Value = arr
                end
                local initial = o.Value
                if initial == nil then initial = o.Default end
                setSelFrom(initial)
                rebuildValue()

                local mainBtn = new("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(172, 34), BackgroundColor3 = C.Btn, AutoButtonColor = false,
                    Text = "", BorderSizePixel = 0,
                }, r.right)
                corner(mainBtn, 10)
                local valText = new("TextLabel", {
                    Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -34, 1, 0), BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.Text,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "",
                }, mainBtn)
                local arrow = new("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(14, 34),
                    BackgroundTransparency = 1, Text = "▾", TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = C.Sub,
                }, mainBtn)

                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                    LayoutOrder = 2, Visible = false,
                }, r.row)
                new("UIPadding", {
                    PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingBottom = UDim.new(0, 12),
                }, holder)
                local list = new("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.45,
                    BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.Accent,
                    CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                }, holder)
                corner(list, 10)
                new("UIPadding", {
                    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                    PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
                }, list)
                new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

                local function displayText()
                    if multi then
                        local n = #obj.Value
                        if n == 0 then return "None" end
                        if n <= 2 then
                            local parts = {}
                            for _, v in ipairs(obj.Value) do table.insert(parts, tostring(v)) end
                            return table.concat(parts, ", ")
                        end
                        return tostring(n) .. " selected"
                    end
                    return tostring(obj.Value == nil and "None" or obj.Value)
                end
                local function isSelected(v)
                    if multi then return sel[v] == true end
                    return obj.Value == v
                end
                local function fire()
                    safe(o.Callback, obj.Value)
                end

                local buildOptions
                buildOptions = function()
                    for _, ch in ipairs(list:GetChildren()) do
                        if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
                    end
                    if #values == 0 then
                        new("TextLabel", {
                            Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "(empty)",
                            Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = C.Sub,
                        }, list)
                    end
                    for i, v in ipairs(values) do
                        local b = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.White,
                            BackgroundTransparency = isSelected(v) and 0.88 or 1, AutoButtonColor = false,
                            Text = "", LayoutOrder = i, BorderSizePixel = 0,
                        }, list)
                        corner(b, 8)
                        new("TextLabel", {
                            Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -40, 1, 0), BackgroundTransparency = 1,
                            Text = tostring(v), Font = Enum.Font.Gotham, TextSize = 13,
                            TextColor3 = isSelected(v) and C.AccentLight or C.Text,
                            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                        }, b)
                        new("TextLabel", {
                            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(20, 32),
                            BackgroundTransparency = 1, Text = isSelected(v) and "✓" or "", TextSize = 14,
                            Font = Enum.Font.GothamBold, TextColor3 = C.AccentLight,
                        }, b)
                        b.Activated:Connect(function()
                            if multi then
                                if sel[v] then sel[v] = nil else sel[v] = true end
                                rebuildValue()
                            else
                                obj.Value = v
                                open = false
                                holder.Visible = false
                                arrow.Text = "▾"
                            end
                            valText.Text = displayText()
                            buildOptions()
                            fire()
                        end)
                    end
                    local h = math.min(math.max(#values, 1), 6) * 32 + 8
                    list.Size = UDim2.new(1, 0, 0, h)
                end

                function obj.Set(s, v)
                    v = argOf(s, v)
                    setSelFrom(v)
                    rebuildValue()
                    valText.Text = displayText()
                    buildOptions()
                    fire()
                end
                obj.SetValue = obj.Set
                function obj.Get() return obj.Value end
                function obj.SetValues(s, vals)
                    vals = argOf(s, vals)
                    values = {}
                    for _, v in ipairs(vals or {}) do table.insert(values, v) end
                    rebuildValue()
                    valText.Text = displayText()
                    buildOptions()
                end
                obj.Refresh = obj.SetValues

                mainBtn.Activated:Connect(function()
                    open = not open
                    holder.Visible = open
                    arrow.Text = open and "▴" or "▾"
                end)
                valText.Text = displayText()
                themed(function() buildOptions() end)
                return register(id, obj)
            end

            -- ---------------------------------------------------------------- Input
            function Tab:AddInput(id, o)
                id, o = parseArgs(id, o)
                local r = makeRow(o.Title, o.Desc or o.Description, 176)
                local obj = { __ui = true, Id = id, Type = "Input" }
                local init = o.Value
                if init == nil then init = o.Default end
                obj.Value = tostring(init == nil and "" or init)
                local box = new("TextBox", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(172, 34), BackgroundColor3 = C.Btn, BorderSizePixel = 0,
                    Text = obj.Value, PlaceholderText = tostring(o.Placeholder or ""),
                    PlaceholderColor3 = Color3.fromRGB(110, 110, 115), TextColor3 = C.Text,
                    Font = Enum.Font.GothamMedium, TextSize = 13, ClearTextOnFocus = false,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, r.right)
                corner(box, 10)
                new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, box)
                box.FocusLost:Connect(function()
                    obj.Value = box.Text
                    safe(o.Callback, obj.Value)
                end)
                function obj.Set(s, v)
                    v = argOf(s, v)
                    obj.Value = tostring(v == nil and "" or v)
                    box.Text = obj.Value
                    safe(o.Callback, obj.Value)
                end
                obj.SetValue = obj.Set
                function obj.Get() return obj.Value end
                return register(id, obj)
            end

            -- --------------------------------------------------------------- Button
            function Tab:AddButton(o, cb)
                if type(o) ~= "table" then o = { Title = tostring(o), Callback = cb } end
                local r = makeRow(o.Title, o.Desc or o.Description, 44)
                local obj = { __ui = true, Type = "Button" }
                local bi = new("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(34, 34),
                    BackgroundColor3 = C.Btn, BorderSizePixel = 0, Text = "›", TextSize = 26,
                    Font = Enum.Font.GothamBold, TextColor3 = C.AccentLight,
                }, r.right)
                corner(bi, 10)
                themed(function() bi.TextColor3 = C.AccentLight end)
                local hit = new("TextButton", {
                    Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.White, BackgroundTransparency = 1,
                    Text = "", AutoButtonColor = false, ZIndex = 5, BorderSizePixel = 0,
                }, r.main)
                corner(hit, 14)
                hit.Activated:Connect(function()
                    hit.BackgroundTransparency = 0.88
                    tween(hit, 0.25, { BackgroundTransparency = 1 })
                    safe(o.Callback)
                end)
                function obj.Fire() safe(o.Callback) end
                return obj
            end

            return Tab
        end

        -- ============================================================ Window API
        function Window:SetTitle(t) titleLbl.Text = tostring(t or "") end
        function Window:SetSubtitle(_) end
        function Window:SetUIScale(s)
            s = tonumber(s)
            if s then uiScale.Scale = math.clamp(s, 0.2, 1.5) end
            return uiScale.Scale
        end
        function Window:Destroy()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            table.clear(conns)
            if gui and gui.Parent then gui:Destroy() end
        end
        function Window:SetTheme(n) Library:SetTheme(n) end
        function Window:SetTransparency(v) Library:SetTransparency(v) end
        function Window:GetThemes() return Library.ThemeNames end
        Window.Unload = Window.Destroy
        Window.Shell = shell
        Window.Gui = gui
        return Window
    end

    CurrentLibrary = Library
    return Library
end

