        Title = "PAYOMBØYZ",
        Name = State.Language == "TH" and "ตีดาบไปกับพยอมบอย" or "PAYOMBØYZ +1 LOOT A FORGE",
        Subtitle = T("WindowSub"),
        VersionTag = T("VersionTag"),
        DefaultTab = State.Language == "TH" and "หน้าหลัก" or "Home",
        Theme = startTheme,
        Motion = "Full",
        Logo = localLogo,
        Effects = {
            Lightning = true,
            Sparks = true,
            CapsuleSparks = false,
            Sound = true,
            Intro = false,
            SparkCount = 4,
            CapsuleSparkCount = 0,
        },
    })

    local tabIcons = { "home", "package", "raid", "flame", "spark", "sword", "player", "trophy", "travel", "settings" }
    local thaiTabNames = { "หน้าหลัก", "แร่", "ดันเจี้ยน", "ล่าบอส", "ฝึกพลัง", "หลอมดาบ", "คลาส/สัตว์", "รางวัล", "เดินทาง", "ตั้งค่า" }
    local englishTabNames = { "Home", "Loot", "Dungeon", "Boss Hunt", "Training", "Forge", "Classes", "Rewards", "Travel", "Settings" }
    local tabCount = 0
    local Window = {}

    function Window:Tab(config)
        tabCount += 1
        local navName = (State.Language == "TH" and thaiTabNames or englishTabNames)[tabCount] or config.Title
        local nativeTab = EngineWindow:AddTab({ Title = navName, Icon = tabIcons[tabCount] or "spark" })
        local adapter = { Native = nativeTab, SectionHandle = nil }

        function adapter:Section(sectionConfig)
            sectionConfig = type(sectionConfig) == "table" and sectionConfig or {}
            self.SectionHandle = self.Native:CreateSection({
                Name = sectionConfig.Title or sectionConfig.Name or "Section",
                Description = sectionConfig.Description or sectionConfig.Desc or "",
                Icon = tabIcons[tabCount] or "spark",
                Expanded = true,
                Side = sectionConfig.Side or sectionConfig.Column,
            })
            return self.SectionHandle
        end
        function adapter:Toggle(control)
            return self.SectionHandle:CreateToggle({
                Name = control.Title, Note = control.Desc, Default = control.Value,
                Callback = function(value)
                    if not UIRebuilding and type(control.Callback) == "function" then control.Callback(value) end
                end,
            })
        end
        function adapter:Button(control)
            return self.SectionHandle:CreateButton({ Name = control.Title, Note = control.Desc, Icon = "spark", Callback = control.Callback })
        end
        function adapter:Dropdown(control)
            return self.SectionHandle:CreateDropdown({ Name = control.Title, Note = control.Desc, Options = control.Values or {}, Default = control.Value, Callback = control.Callback })
        end
        function adapter:Slider(control)
            local range = type(control.Value) == "table" and control.Value or {}
            return self.SectionHandle:CreateSlider({
                Name = control.Title, Note = control.Desc,
                Min = range.Min or 0, Max = range.Max or 100,
                Default = range.Default or range.Min or 0, Rounding = range.Rounding,
                Callback = control.Callback,
            })
        end
        function adapter:Input(control)
            return self.SectionHandle:CreateInput({
                Name = control.Title, Note = control.Desc,
                Placeholder = control.Placeholder or "", Default = control.Value or control.Default or "",
                MaxLength = control.MaxLength, Callback = control.Callback,
            })
        end
        function adapter:Paragraph(control)
            local paragraph = self.SectionHandle:CreateCallout({
                Name = control.Title, Text = control.Desc or "", Kind = control.Kind or "Info",
            })
            paragraph.Instance.AutomaticSize = Enum.AutomaticSize.Y
            paragraph.TextLabel.AutomaticSize = Enum.AutomaticSize.Y
            paragraph.TextLabel.Size = UDim2.new(1, -30, 0, 0)
            paragraph.TextLabel.TextWrapped = true
            return {
                SetDesc = function(_, text) paragraph:Set(text) end,
                Set = function(_, text) paragraph:Set(text) end,
            }
        end
        return adapter
    end

    function Window:SelectTab(target)
        if type(target) == "number" then target = EngineWindow.Tabs[target] end
        return EngineWindow:SelectTab(target)
    end
    function Window:Destroy()
        EngineWindow:Unload()
        if CurrentWindow == self then CurrentWindow = nil end
    end
    function Window:Toggle() return EngineWindow:Toggle() end
    function Window:ToggleTransparency(enabled)
        if EngineWindow.Shell then EngineWindow.Shell.BackgroundTransparency = enabled and 0.14 or 0.04 end
    end
    function Window:SetTheme(name) return EngineWindow:SetTheme(name) end
    function Window:SetAccent(color) return EngineWindow:SetAccent(color) end
    function Window:SetMotion(mode) return EngineWindow:SetMotion(mode) end
    function Window:SetEffects(name, value) return EngineWindow:SetEffects(name, value) end
    CurrentWindow = Window

    if not ToggleUiConnection then
        ToggleUiConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.RightShift and CurrentWindow then
                CurrentWindow:Toggle()
            end
        end)
    end

