-- Capability Patch: GuiService.ErrorMessageChanged needs RobloxScript
-- Executor scripts lack this capability — stub it out so the UI library
-- doesn't crash when it tries to connect to it.
-- ─────────────────────────────────────────────────────────────
pcall(function()
    if not GuiService or not GuiService.ErrorMessageChanged then return end
    local dummyBE = Instance.new("BindableEvent")
    -- Override the property with a dummy that accepts :Connect() without crashing
    local mt = getrawmetatable and getrawmetatable(GuiService)
    if mt then
        local oldIndex = mt.__index
        mt.__index = newcclosure and newcclosure(function(self, key)
            if key == "ErrorMessageChanged" then return dummyBE.Event end
            if type(oldIndex) == "function" then return oldIndex(self, key) end
            return rawget(self, key)
        end) or mt.__index
    end
end)

