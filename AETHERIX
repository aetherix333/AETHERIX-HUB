    end

    -- Targeted prompt activation: only scan OreCache (and Drops if exists), avoiding entire workspace scan
    for _, p in ipairs(prompts) do
        pcall(function()
            p.MaxActivationDistance = 1e6
            p.RequiresLineOfSight = false
