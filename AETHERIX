local UIRebuilding = false
local UI_SOURCE_URL = "https://raw.githubusercontent.com/payomboyz333/Library/main/PayomboyZ-UI"

local function loadPayomboyZLibrary()
    if CurrentLibrary then return CurrentLibrary end
    if type(loadstring) ~= "function" then
        error("PAYOMBØYZ UI needs a Luau runtime that provides loadstring.", 0)
    end

    local ok, source = pcall(function() return game:HttpGet(UI_SOURCE_URL, true) end)
    if not ok or type(source) ~= "string" or source == "" then
        error("Could not download PAYOMBØYZ UI from GitHub URL: " .. tostring(source), 0)
    end

    local chunk, compileError = loadstring(source)
    if type(chunk) ~= "function" then
        error("PayomboyZ UI compile failed: " .. tostring(compileError), 0)
    end
    local initOk, library = pcall(chunk)
    if not initOk or type(library) ~= "table" or type(library.CreateWindow) ~= "function" then
        error("PayomboyZ UI initialization failed: " .. tostring(library), 0)
    end
    CurrentLibrary = library
    return library
end

BuildUI = function()
    if CurrentWindow then
        UIRebuilding = true
        pcall(function() CurrentWindow:Destroy() end)
        CurrentWindow = nil
        UIRebuilding = false
    end

    local Library = loadPayomboyZLibrary()
    local startTheme = "Crimson"
    local localLogo = "https://raw.githubusercontent.com/payomboyz333/Library/refs/heads/main/LogoPayomboyZ.png" 

