            setclipboard(table.concat(Spy.Logs, "\n"))
            Notify("คัดลอกแล้ว", "คัดลอก " .. #Spy.Logs .. " รายการ")
        else
            Notify("ไม่รองรับ", "ตัวรันของคุณไม่รองรับ setclipboard")
        end
    end,
})

