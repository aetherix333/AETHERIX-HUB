    for _, enemy in ipairs(enemyFolder:GetChildren()) do
        if enemy:IsA("Model") and not enemy:GetAttribute("Dead") then
            local id = tostring(enemy:GetAttribute("EnemyID") or enemy.Name)
            local isBoss = id:match("^Boss_%d") ~= nil or id:match("^WorldBoss") ~= nil
            if not (bossMode and isBoss) then
                instantKillEnemy(enemy)
                killed = killed + 1
