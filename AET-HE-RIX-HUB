-- ★ SCAN REAL ORE DATA & EXTRACT ASSET IMAGES
local function scanGameOres()
    table.clear(Dynamic.ScannedOres)
    table.clear(Dynamic.OreNamesList)

    local OreCfg, OreShow, OreHlp
    pcall(function() OreCfg = require(ReplicatedStorage.Config.Ore.Config) end)
    pcall(function() OreShow = require(ReplicatedStorage.Config.Ore.Show) end)
    pcall(function() OreHlp = require(ReplicatedStorage.Config.Ore.Helper) end)

    local cfgTable = {}
    if type(OreCfg) == "table" then
        cfgTable = OreCfg
    elseif OreHlp and type(OreHlp.GetConfig) == "function" then
        pcall(function() cfgTable = OreHlp.GetConfig() end)
    end

    local showTable = type(OreShow) == "table" and OreShow or {}

    local function getRarityAssetImage(rarityName)
        local sf = ReplicatedStorage:FindFirstChild("Assets")
            and ReplicatedStorage.Assets:FindFirstChild("Rarity")
            and ReplicatedStorage.Assets.Rarity:FindFirstChild("SquareFrame")
        if sf then
            local frame = sf:FindFirstChild(rarityName)
            if frame and frame:FindFirstChild("Frame") and frame.Frame:FindFirstChild("ImageLabel") then
                return frame.Frame.ImageLabel.Image
            end
        end
        return ""
    end

    for id, data in pairs(cfgTable) do
        local oreId = tostring(type(data) == "table" and (data.ID or data.Id or id) or id)
        local name = type(data) == "table" and (data.Name or data.name or ("Ore " .. oreId)) or tostring(id)
        local rarity = type(data) == "table" and (data.Rarity or data.Rare or "Common") or "Common"
        local power = 0
        if OreHlp and type(OreHlp.GetPower) == "function" then
            pcall(function() power = OreHlp.GetPower(oreId) or 0 end)
        elseif type(data) == "table" and data.Power then
            power = data.Power
        end

        local icon = ""
        if type(data) == "table" then
            icon = data.Icon or data.Image or data.Img or data.IconId or ""
        end
        if icon == "" and showTable[oreId] then
            local s = showTable[oreId]
            icon = (type(s) == "table" and (s.Icon or s.Image or s.Img or s.IconId)) or (type(s) == "string" and s) or ""
        end
        if icon == "" and showTable[name] then
            local s = showTable[name]
            icon = (type(s) == "table" and (s.Icon or s.Image or s.Img or s.IconId)) or (type(s) == "string" and s) or ""
        end
        if icon == "" then
            icon = getRarityAssetImage(rarity)
        end

        if type(icon) == "number" or (type(icon) == "string" and tonumber(icon)) then
            icon = "rbxassetid://" .. tostring(icon)
        end

        Dynamic.ScannedOres[oreId] = {
            ID = oreId,
            Name = tostring(name),
            Rarity = tostring(rarity),
            Power = tonumber(power) or 0,
            Icon = tostring(icon),
        }
    end

    if next(Dynamic.ScannedOres) == nil then
        local tiers = { "Common", "UnCommon", "Rare", "Epic", "Legendary", "Mythic", "Eternal", "Infinite", "Ancient", "Secret" }
        for idx, r in ipairs(tiers) do
            local fallbackImg = getRarityAssetImage(r)
            Dynamic.ScannedOres[tostring(idx)] = {
                ID = tostring(idx),
                Name = r .. " Ore",
                Rarity = r,
                Power = idx * 100,
                Icon = fallbackImg ~= "" and fallbackImg or "rbxassetid://13837943564",
            }
        end
    end

    for id, ore in pairs(Dynamic.ScannedOres) do
        table.insert(Dynamic.OreNamesList, ("[%s] %s (ID: %s)"):format(ore.Rarity, ore.Name, ore.ID))
    end
    table.sort(Dynamic.OreNamesList)
end
scanGameOres()

