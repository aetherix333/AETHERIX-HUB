                lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
                label(b, tostring(c.Title or ""), 14, FONT_BOLD, C.Text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
                b.MouseButton1Click:Connect(function() if type(c.Callback) == "function" then pcall(c.Callback) end end)
                register(b, c.Title)
                return {}
            end

            function adapter:Dropdown(c)
                local bodyF = target(64)
                local values = c.Values or {}
                local selected = c.Value
                local wrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = bodyF })
                vlist(wrap, 4)
                label(wrap, tostring(c.Title or ""), 14, FONT_MED, C.Text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
                local headBtn = new("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = C.Elem, Size = UDim2.new(1, 0, 0, 34),
                    BorderSizePixel = 0, Parent = wrap,
                })
                corner(headBtn, 6)
                stroke(headBtn, C.Stroke, 1)
                local cur = label(headBtn, tostring(selected or ""), 14, FONT_MED, C.Text, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -36, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
                local list = new("ScrollingFrame", {
                    BackgroundColor3 = C.Elem, Size = UDim2.new(1, 0, 0, 120), CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, BorderSizePixel = 0,
                    Visible = false, Parent = wrap,
                })
                corner(list, 6)
                stroke(list, C.Stroke, 1)
                vlist(list, 2)

                local function rebuild()
                    for _, ch in ipairs(list:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
                    for i, v in ipairs(values) do
                        local o = new("TextButton", {
                            Text = tostring(v), AutoButtonColor = false, BackgroundColor3 = C.ElemHi, BackgroundTransparency = 1,
                            TextColor3 = (v == selected) and C.Accent or C.Text, TextSize = 13, Font = FONT_MED,
                            Size = UDim2.new(1, 0, 0, 28), BorderSizePixel = 0, Parent = list,
                        })
                        o.MouseButton1Click:Connect(function()
                            selected = v
                            cur.Text = tostring(v)
                            list.Visible = false
                            rebuild()
                            if type(c.Callback) == "function" then pcall(c.Callback, v) end
                        end)
                    end
                end
                rebuild()
                headBtn.MouseButton1Click:Connect(function() list.Visible = not list.Visible end)
                register(wrap, c.Title)
                return {
                    Set = function(_, v) selected = v; cur.Text = tostring(v); rebuild() end,
                    Refresh = function(_, nv) values = nv or {}; rebuild() end
                }
            end

            function adapter:Slider(c)
                local bodyF, scroll = target(50)
                local range = type(c.Value) == "table" and c.Value or {}
                local min, max = range.Min or 0, range.Max or 100
                local step = c.Step or 1
                local value = math.clamp(range.Default or min, min, max)
                local wrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = bodyF })
                vlist(wrap, 4)
                local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = wrap })
                label(top, tostring(c.Title or ""), 14, FONT_MED, C.Text, { Size = UDim2.new(1, -60, 1, 0) })
                local valLbl = label(top, tostring(value), 13, FONT_BOLD, C.Accent, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(56, 18), TextXAlignment = Enum.TextXAlignment.Right })
                local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Parent = wrap })
                local track_ = new("Frame", { BackgroundColor3 = C.ElemHi, Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0, Parent = hit })
                corner(track_, 3)
                local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, Parent = track_ })
                accent(fill, "BackgroundColor3")
                corner(fill, 3)

                local function paint()
                    local a = (max == min) and 0 or (value - min) / (max - min)
                    fill.Size = UDim2.new(a, 0, 1, 0)
                    valLbl.Text = tostring(math.floor(value + 0.5))
                end
                paint()

                hit.InputBegan:Connect(function(input)
                    if isPointer(input) then
                        local w = track_.AbsoluteSize.X
                        local a = math.clamp((input.Position.X - track_.AbsolutePosition.X) / w, 0, 1)
                        value = math.floor(min + (max - min) * a)
                        paint()
                        if type(c.Callback) == "function" then pcall(c.Callback, value) end
                    end
                end)
                register(wrap, c.Title)
                return { Set = function(_, v) value = math.clamp(v, min, max); paint() end }
            end

            function adapter:Paragraph(c)
                local bodyF = target(60)
                local box = new("Frame", { BackgroundColor3 = C.Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, Parent = bodyF })
                corner(box, 8)
                stroke(box, C.Accent, 1)
                padding(box, 10, 8, 10, 10)
                vlist(box, 3)
                label(box, tostring(c.Title or ""), 15, FONT_BOLD, C.Text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
                local desc = label(box, tostring(c.Desc or ""), 13, FONT_REG, C.Sub, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true })
                register(box, c.Title or "")
                return { SetDesc = function(_, text) desc.Text = tostring(text or "") end }
            end

            -- ★ IMAGE CARD COMPONENT
            function adapter:ImageCard(c)
                local bodyF = target(72)
                local box = new("Frame", {
                    BackgroundColor3 = C.Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BorderSizePixel = 0, Parent = bodyF,
                })
                corner(box, 8)
                local st = stroke(box, C.Accent, 1)
                accent(st, "Color")
                padding(box, 10, 8, 10, 10)

                local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), Parent = box })
                local img = new("ImageLabel", {
                    BackgroundColor3 = C.Elem, Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(0, 2),
                    BorderSizePixel = 0, Image = tostring(c.Image or ""), ScaleType = Enum.ScaleType.Fit, Parent = row
                })
                corner(img, 6)
                stroke(img, C.Stroke, 1)

                local infoHolder = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(66, 0), Size = UDim2.new(1, -66, 1, 0), Parent = row })
                vlist(infoHolder, 2)
                local titleLbl = label(infoHolder, tostring(c.Title or ""), 14, FONT_BOLD, C.Text, { Size = UDim2.new(1, 0, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
                local descLbl = label(infoHolder, tostring(c.Desc or ""), 12, FONT_REG, C.Sub, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true })

                register(box, (c.Title or "") .. " " .. (c.Desc or ""))
                return {
                    SetImage = function(_, asset) img.Image = tostring(asset or "") end,
                    SetTitle = function(_, t) titleLbl.Text = tostring(t or "") end,
                    SetDesc  = function(_, d) descLbl.Text = tostring(d or "") end
                }
            end

            function adapter:Input(c)
                local bodyF = target(64)
                local wrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = bodyF })
                vlist(wrap, 4)
                label(wrap, tostring(c.Title or ""), 14, FONT_MED, C.Text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
                local box = new("TextBox", {
                    BackgroundColor3 = C.Elem, Size = UDim2.new(1, 0, 0, 34), PlaceholderText = tostring(c.Placeholder or ""),
                    Text = tostring(c.Value or ""), TextColor3 = C.Text, TextSize = 14, Font = FONT_MED,
                    BorderSizePixel = 0, Parent = wrap,
                })
                corner(box, 6)
                stroke(box, C.Stroke, 1)
                box.FocusLost:Connect(function() if type(c.Callback) == "function" then pcall(c.Callback, box.Text) end end)
                return { Set = function(_, v) box.Text = tostring(v) end }
            end

            if #tabs == 1 and not activeTab then selectTab(tab) end
            return adapter
        end

        function Window:Destroy()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            pcall(function() gui:Destroy() end)
        end

        return Window
    end

    return Lib
end)()

