local function getBestTrainZone()
    local curReb = 0
    pcall(function()
        local pd = ProfileData and ProfileData.GetTotalData and ProfileData.GetTotalData()
        curReb = pd and pd.Eco and tonumber(pd.Eco.rebirth) or 0
