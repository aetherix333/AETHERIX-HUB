local RemoteCache = {}
local function getRemote(folder, name)
    if not RemoteRoot then return nil end
    local key = folder .. "/" .. name
    local cached = RemoteCache[key]
    if cached and cached.Parent then return cached end
    for _, fname in ipairs({ folder .. "_Server", folder }) do
        local f = RemoteRoot:FindFirstChild(fname)
        local r = f and f:FindFirstChild(name)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            RemoteCache[key] = r
            return r
        end
    end
    for _, f in ipairs(RemoteRoot:GetChildren()) do
        local r = f:FindFirstChild(name)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            RemoteCache[key] = r
            return r
        end
    end
    return nil
end

local function call(folder, name, ...)
    local r = getRemote(folder, name)
    if not r then
        if State.Debug then warn("[AETHERIX] Remote missing:", folder, name) end
        return nil
    end
    local args = { ... }
    local ok, res = pcall(function()
        if r:IsA("RemoteFunction") then
            return r:InvokeServer(unpack(args))
        else
            r:FireServer(unpack(args))
        end
    end)
    return ok and res or nil
end

