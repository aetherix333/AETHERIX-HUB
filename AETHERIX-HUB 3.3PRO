        OreFilter           = {},          -- ว่าง = เก็บทุกแร่
        MasterCollect       = true,        -- ให้โหมด 24/7 ดูดแร่ด้วยตัวเอง (ไม่แตะเตาหลอม/ร้านค้า)
        MasterDungeonTicket = true,
