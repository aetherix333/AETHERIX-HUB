    T1:Toggle({
        Title = LT("ให้โหมด 24/7 ดูดและเก็บแร่เอง", "Master Collects Ores"),
        Desc  = LT("เก็บเฉพาะของดรอป ไม่แตะเตาหลอม/ร้านค้า/ขายของ", "Only drops are touched; never the forge/shop/sell"),
