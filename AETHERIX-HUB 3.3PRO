local State = makeDefaults()

-- คีย์ที่ไม่ถูกบันทึกลงโปรไฟล์
local NonPersistent = { CurrentProfile = true, Debug = true }

local function T(key)
    local lang = State.Language or "TH"
    local dict = Locales[lang] or Locales.TH
    return dict[key] or Locales.TH[key] or key
end

local function TF(key, ...)
    local str = T(key)
    return string.format(str, ...)
end

-- ข้อความสองภาษาแบบสั้น (ใช้กับส่วนที่เพิ่มใหม่ใน v3.3)
local function LT(th, en)
    return State.Language == "EN" and en or th
end

local Stats = {
    StartTime       = os.time(),
    OresCollected   = 0,
    SellCycles      = 0,
    Kills           = 0,
    RebirthCount    = 0,
    SuperLootKills  = 0,
    CurrentActivity = "StatusReady",
    LastStageClear  = os.time(),
    LastHourlyPost  = os.time(),
}

-- ─────────────────────────────────────────────────────────────
-- Networking & Instance Helpers
-- ─────────────────────────────────────────────────────────────
local function getRemote(folder, name)
    if not RemoteRoot then return nil end
    local f = RemoteRoot:FindFirstChild(folder)
    return f and f:FindFirstChild(name) or nil
end

local RemoteLocks = {}

local function call(folder, name, ...)
    local r = getRemote(folder, name)
    if not r then
        if State.Debug then warn("[Aetherix] Remote missing:", folder, name) end
        return nil
    end

    local key = folder .. "/" .. name
    local args = { ... }
    local n = select("#", ...)

    if r:IsA("RemoteFunction") then
        if RemoteLocks[key] then
            if State.Debug then warn("[Aetherix] Remote busy:", key) end
            return nil
        end

        RemoteLocks[key] = true
        local ok, res = pcall(function()
            return r:InvokeServer(unpack(args, 1, n))
        end)
        RemoteLocks[key] = nil
        if ok then return res end
        return nil
    end

    pcall(function()
        r:FireServer(unpack(args, 1, n))
    end)
    return nil
end

local ActionDebounce = {}

local function once(key, cooldown, fn)
    local now = os.clock()
    local last = ActionDebounce[key] or 0
    if now - last < (cooldown or 0.35) then
        return false
    end

    ActionDebounce[key] = now
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok and State.Debug then
            warn("[Aetherix Action Error]:", key, err)
        end
    end)
    return true
end

local function char() return LocalPlayer.Character end
local function hrp()  local c = char(); return c and c:FindFirstChild("HumanoidRootPart") end
local function hum()  local c = char(); return c and c:FindFirstChildOfClass("Humanoid") end

local function getSafeZoneCF()
    local spawn = workspace:FindFirstChild("SpawnLocation")
    if spawn then
        if spawn:IsA("Model") then return spawn:GetPivot() end
        if spawn:IsA("BasePart") then return spawn.CFrame end
    end
    local spawnObj = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if spawnObj then return spawnObj.CFrame end
    return CFrame.new(0, 5, 0)
end

local function tpTo(cf)
    local r = hrp()
    if r then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
        r.CFrame = cf + Vector3.new(0, 3, 0)
    end
end

local function getPackInfo()
    local cur, maxNum = 0, 10
    pcall(function()
        local LeftInfoGUI = require(ReplicatedStorage.GuiUtils.LeftInfoGUI)
        cur = LeftInfoGUI.GetOrePack() or 0
    end)
    pcall(function()
        local UpgradeData = require(ReplicatedStorage.LocalData.UpgradeData)
        maxNum = UpgradeData.GetMaxNum("OrePack") or 10
    end)
    return cur, maxNum
end

local function getBindable(category, name)
    local be = nil
    pcall(function()
        local CommunicationUtils = require(ReplicatedStorage.Utils.CommunicationUtils)
        be = CommunicationUtils.TryGetBindableEvent(category, name)
    end)
    return be
end

-- ─────────────────────────────────────────────────────────────
-- Loop Registry (ลูปทุกตัวลงทะเบียนไว้ เพื่อให้เริ่มใหม่ได้หลังโหลดโปรไฟล์)
-- ─────────────────────────────────────────────────────────────
local ActiveThreads = {}
local LoopDefs = {}

local function loop(flag, delay, fn)
    if ActiveThreads[flag] then return end
    ActiveThreads[flag] = true
    task.spawn(function()
        while Alive and State[flag] do
            local ok, err = pcall(fn)
            if not ok and State.Debug then warn("[Aetherix Loop Error]:", flag, err) end
            local waitTime = type(delay) == "string" and State[delay] or delay
            task.wait(math.max(waitTime or 0.1, 0.05))
        end
        ActiveThreads[flag] = nil
    end)
end

local function toggleLoop(flag, delay, fn)
    LoopDefs[flag] = { delay = delay, fn = fn }
    return function(v)
        State[flag] = v
        if v then loop(flag, delay, fn) end
    end
end

local function startLoops()
    for flag, def in pairs(LoopDefs) do
        if State[flag] then loop(flag, def.delay, def.fn) end
    end
end

-- ─────────────────────────────────────────────────────────────
-- Ore Filter (เลือกแร่ที่จะเก็บ ว่าง = เก็บทั้งหมด)
-- ─────────────────────────────────────────────────────────────
local function oreMatches(name)
    local f = State.OreFilter
    if type(f) ~= "table" or #f == 0 then return true end
    local ln = tostring(name):lower()
    for _, k in ipairs(f) do
        if ln:find(tostring(k):lower(), 1, true) then return true end
    end
    return false
end

-- ─────────────────────────────────────────────────────────────
-- Discord Webhook Telemetry
-- ─────────────────────────────────────────────────────────────
local function sendWebhook(title, description, fields, color)
    if not State.WebhookEnabled or not State.WebhookUrl or State.WebhookUrl == "" then return end
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end

    task.spawn(function()
        local embed = {
            title = title,
            description = description,
            color = color or 9133302,
            fields = fields or {},
            footer = { text = "Aetherix Hub v3.3 Pro | 24/7 Telemetry" },
            timestamp = DateTime.now():ToIsoDate(),
        }
        pcall(function()
            req({
                Url = State.WebhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ embeds = { embed } }),
            })
        end)
    end)
end

-- ─────────────────────────────────────────────────────────────
-- Config Profiles (บันทึกหลายชุด ตั้งชื่อได้ เลือกโหลดได้)
-- ─────────────────────────────────────────────────────────────
local RootDir         = "AetherixHub"
local ProfileDir      = RootDir .. "/Profiles"
local LastProfileFile = RootDir .. "/last_profile.txt"
local LastSavedJSON   = nil
local PlayerModsTouched = false

local function fsReady()
    return writefile and readfile and isfile and makefolder and isfolder and true or false
end

local function ensureDirs()
    if not fsReady() then return false end
    pcall(function() if not isfolder(RootDir) then makefolder(RootDir) end end)
    pcall(function() if not isfolder(ProfileDir) then makefolder(ProfileDir) end end)
    return true
end

local function sanitizeName(n)
    n = tostring(n or "")
    n = n:gsub('[\\/:*?"<>|\1-\31]', "")
    n = n:gsub("^[ \t]+", "")
    n = n:gsub("[ \t]+$", "")
    -- ตัดความยาวตามจำนวนตัวอักษร (ไม่ตัดกลางตัวอักษรไทย 3 ไบต์)
    local okLen, len = pcall(utf8.len, n)
    if okLen and len and len > 40 then
        local okOff, off = pcall(utf8.offset, n, 41)
        if okOff and off then n = n:sub(1, off - 1) end
    elseif not (okLen and len) and #n > 40 then
        n = n:sub(1, 40)
    end
    return n
end

local function profilePath(name)
    return ProfileDir .. "/" .. name .. ".json"
end

local function listProfiles()
    local out = {}
    if listfiles and isfolder and isfolder(ProfileDir) then
        local ok, files = pcall(listfiles, ProfileDir)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then table.insert(out, n) end
            end
        end
    end
    table.sort(out)
    return out
end

local function snapshotState()
    local snap = {}
    for k, v in pairs(State) do
        if not NonPersistent[k] then snap[k] = v end
    end
    return snap
end

local function encodeState()
    local ok, encoded = pcall(function() return HttpService:JSONEncode(snapshotState()) end)
    if ok then return encoded end
    return nil
end

local function saveProfile(name)
    if not ensureDirs() then return false, "no-fs" end
    name = sanitizeName(name)
    if name == "" then name = sanitizeName(State.CurrentProfile) end
    if name == "" then name = "Default" end

    local encoded = encodeState()
    if not encoded then return false, "encode" end

    local ok = pcall(function()
        writefile(profilePath(name), encoded)
        writefile(LastProfileFile, name)
    end)
    if not ok then return false, "write" end

    State.CurrentProfile = name
    LastSavedJSON = encoded
    return true, name
end

-- รีเซ็ตทุกอย่างเป็นค่าเริ่มต้นก่อน แล้วค่อยใส่ค่าที่โหลดมา
local function applyDecoded(decoded)
    local fresh = makeDefaults()
    for k, v in pairs(fresh) do
        if not NonPersistent[k] then State[k] = v end
    end
    for k, v in pairs(decoded) do
        if fresh[k] ~= nil and not NonPersistent[k] and type(fresh[k]) == type(v) then
            State[k] = v
        end
    end
    -- ตัดให้เหลือ 3 ด่าน
    if type(State.FarmStages) == "table" then
        while #State.FarmStages > 3 do table.remove(State.FarmStages) end
    end
end

local function loadProfile(name)
    if not fsReady() then return false end
    name = sanitizeName(name)
    if name == "" or not isfile(profilePath(name)) then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(profilePath(name)))
    end)
    if not (ok and type(decoded) == "table") then return false end

    applyDecoded(decoded)
    State.CurrentProfile = name
    pcall(function() writefile(LastProfileFile, name) end)
    LastSavedJSON = encodeState()
    return true
end

local function deleteProfile(name)
    name = sanitizeName(name)
    if name == "" or not (delfile and isfile and isfile(profilePath(name))) then return false end
    local ok = pcall(delfile, profilePath(name))
    if ok and State.CurrentProfile == name then State.CurrentProfile = "" end
    return ok
end

local function loadLastProfile()
    if not fsReady() then return false end
    ensureDirs()
    if not isfile(LastProfileFile) then return false end
    local ok, name = pcall(readfile, LastProfileFile)
    if not ok then return false end
    name = sanitizeName(name)
    if name == "" or not isfile(profilePath(name)) then return false end

    -- ถ้าโปรไฟล์นั้นปิด "โหลดอัตโนมัติ" ไว้ ให้เริ่มด้วยค่าเริ่มต้นล้วน
    local ok2, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(profilePath(name)))
    end)
    if ok2 and type(decoded) == "table" and decoded.AutoLoadLast == false then
        return false
    end
    return loadProfile(name)
end

-- ─────────────────────────────────────────────────────────────
-- Player Mods (ค่าเริ่มต้นเสมอ ยกเว้นโหลดโปรไฟล์)
-- ─────────────────────────────────────────────────────────────
local function applyPlayerMods()
    local h = hum()
    if not h then return end
    if State.WalkSpeed ~= 16 or State.JumpPower ~= 50 or PlayerModsTouched then
        PlayerModsTouched = true
        h.WalkSpeed = State.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower = State.JumpPower
    end
end


-- ─────────────────────────────────────────────────────────────
-- Misc (forward declarations)
-- ─────────────────────────────────────────────────────────────
local Shutdown

local cpuSaverTouched = false
local function applyCpuSaver()
    if not State.CpuSaver and not cpuSaverTouched then return end
    cpuSaverTouched = true
    pcall(function()
        RunService:Set3dRenderingEnabled(not State.CpuSaver)
        if setfpscap then setfpscap(State.CpuSaver and 15 or 60) end
    end)
end


-- ─────────────────────────────────────────────────────────────
-- Core Engine 1: Drop Magnet & Safe Loot (v3.3: ไม่แตะเตาหลอม/ร้านค้าอีก)
-- ─────────────────────────────────────────────────────────────
local function runDropMagnet()
    local oreCache = workspace:FindFirstChild("OreCache")
    if not oreCache then return end

    local targetCF
    if State.MagnetTarget == "Safe Zone" then
        targetCF = getSafeZoneCF() + Vector3.new(0, 2, 0)
    else
        local r = hrp()
        if not r then return end
        targetCF = r.CFrame
    end

    for _, drop in ipairs(oreCache:GetChildren()) do
        if drop:IsA("Model") and oreMatches(drop.Name) then
            pcall(function()
                if drop.PrimaryPart then
                    drop.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
                    drop.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
                    drop.PrimaryPart.CanCollide = false
                end
                drop:PivotTo(targetCF)
            end)
        end
    end
end

-- สาเหตุที่ v3.3 ไปเปิดเตาหลอม/ขายของ: มันยิง ProximityPrompt "ทุกอัน" ในแมพ (เตาหลอม, ร้านค้า ฯลฯ)
-- v3.3 ยิงเฉพาะ prompt ที่อยู่ใน OreCache (ของดรอป) และเช็คบล็อกคำต้องห้ามซ้ำอีกชั้น
local StrongBlock = {
    "forge", "furnace", "smelt", "anvil", "shop", "sell", "merchant", "vendor",
    "craft", "enchant", "เตา", "หลอม", "ขาย", "ร้าน",
}

local function isBlockedText(s)
    s = tostring(s or ""):lower()
    for _, w in ipairs(StrongBlock) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local notifiedDrops = {}

local function runUltraPrompts()
    if not fireproximityprompt then return end

    local oreCache = workspace:FindFirstChild("OreCache")
    if not oreCache then return end

    if State.NotifyRareDrops and State.WebhookEnabled then
        for _, drop in ipairs(oreCache:GetChildren()) do
            if drop:IsA("Model") and not notifiedDrops[drop] then
                local name = drop.Name
                local highlight = drop:FindFirstChildOfClass("Highlight")
                if highlight and (name:find("Mythic") or name:find("Eternal") or name:find("Secret") or name:find("Ancient") or name:find("Infinite")) then
                    notifiedDrops[drop] = true
                    local isTH = State.Language == "TH"
                    sendWebhook(
                        isTH and "ตรวจพบไอเทมหายากระดับสูง!" or "Rare Item Acquired",
                        isTH and "ระบบดูดของปลอดภัยจัดเก็บไอเทมเข้ากระเป๋าเรียบร้อยแล้ว" or "A rare drop was generated and secured by Safe Magnet.",
                        {
                            { name = isTH and "ชื่อไอเทม" or "Drop Item", value = name, inline = true },
                            { name = isTH and "กิจกรรมปัจจุบัน" or "Location", value = tostring(Stats.CurrentActivity), inline = true },
                        },
                        0xF59E0B
                    )
                end
            end
        end
    end

    for _, p in ipairs(oreCache:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local drop = p
            while drop and drop.Parent and drop.Parent ~= oreCache do drop = drop.Parent end
            local dropName = drop and drop.Name or p.Name
            if oreMatches(dropName) and not isBlockedText(p.ActionText .. " " .. p.ObjectText .. " " .. p.Name) then
                pcall(function()
                    p.MaxActivationDistance = 1e6
                    p.RequiresLineOfSight = false
                    p.HoldDuration = 0
                    fireproximityprompt(p, 0)
                    Stats.OresCollected = Stats.OresCollected + 1
                end)
            end
        end
    end
end

-- v3.3: อพยพแล้ว "ไม่ขาย" และ "ไม่อัปเกรด" เอง ยกเว้นเปิด SellOnEvac
local LastEvac = 0
local function checkSafeEvacuate()
    if os.clock() - LastEvac < 12 then return false end

    local cur, maxNum = getPackInfo()
    local packFullPercent = (cur / math.max(maxNum, 1)) * 100

    local h = hum()
    local hpPercent = h and ((h.Health / math.max(h.MaxHealth, 1)) * 100) or 100

    local shouldEvacuate = false
    local reason = ""

    if State.AutoSafeEvacuate and packFullPercent >= State.EvacuateThreshold then
        shouldEvacuate = true
        reason = ("Pack Full (%d/%d)"):format(cur, maxNum)
    elseif State.LowHPEvacuate and hpPercent <= State.LowHPThreshold then
        shouldEvacuate = true
        reason = ("Critical HP (%.1f%%)"):format(hpPercent)
    end

    if shouldEvacuate then
        LastEvac = os.clock()
        Stats.CurrentActivity = TF("StatusSafeEvacuate", reason)
        call("Stage", "ClaimedAllOreRE")
        tpTo(getSafeZoneCF())
        task.wait(0.4)
        if State.SellOnEvac then
            call("Backpack", "TrySellAllRE")
            Stats.SellCycles = Stats.SellCycles + 1
            task.wait(0.2)
        end
        task.wait(0.4)
        notify(
            LT("อพยพปลอดภัย", "Safe Zone Evacuate"),
            LT("จัดเก็บแร่เข้าโซนปลอดภัยเรียบร้อยแล้ว (", "Loot secured at Safe Zone (") .. reason .. ")",
            "shield-check"
        )
        return true
    end
    return false
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 2: Combat, Instant Kill & God Mode
-- ─────────────────────────────────────────────────────────────
local function getEnemies()
    local out = {}
    local folder = workspace:FindFirstChild("EnemyFolder")
    if folder then
        for _, e in ipairs(folder:GetChildren()) do
            if e:IsA("Model") and not e:GetAttribute("Dead") then
                table.insert(out, e)
            end
        end
    end
    return out
end

local function fireHit(hitBE, name)
    pcall(function()
        hitBE:Fire(name, 99999999, { SkillID = "K_Skill_1_ATK" })
    end)
end

local function runKillAura()
    local hitBE = getBindable("Attack", "EnemyHitBE")
    if not hitBE then return end

    for _, enemy in ipairs(getEnemies()) do
        fireHit(hitBE, enemy.Name)
        Stats.Kills = Stats.Kills + 1
    end

    local superLootFolder = workspace:FindFirstChild("SuperLootFolder")
    if superLootFolder then
        for _, s in ipairs(superLootFolder:GetChildren()) do
            fireHit(hitBE, s.Name)
        end
    end
end

-- วาร์ปไปหามอนสเตอร์แล้วฆ่าทันที (ใช้ทั้งดันเจี้ยนและไต่ด่าน)
local function instantKillAll(warp)
    local enemies = getEnemies()
    if #enemies == 0 then return 0 end

    if warp then
        local first = enemies[1]
        local part = first.PrimaryPart or first:FindFirstChildWhichIsA("BasePart", true)
        if part then
            tpTo(part.CFrame + Vector3.new(0, State.FlightHeight, 0))
        end
    end

    runKillAura()
    return #enemies
end

local function runSafeFlight()
    if not State.SafeCombatFlight then return end
    local r = hrp()
    if not r then return end

    local enemies = getEnemies()
    local first = enemies[1]
    if first and first.PrimaryPart then
        local enemyPos = first.PrimaryPart.Position
        r.AssemblyLinearVelocity = Vector3.zero
        r.CFrame = CFrame.new(enemyPos.X, enemyPos.Y + State.FlightHeight, enemyPos.Z)
    end
end

local LastGodModeTick = 0
local GodModeController = nil

local function maintainGodMode()
    if not State.GodMode then return end

    local now = os.clock()
    if now - LastGodModeTick < 0.25 then return end
    LastGodModeTick = now

    pcall(function()
        LocalPlayer:SetAttribute("Invincible", true)

        if not GodModeController then
            GodModeController = require(ReplicatedStorage.CTRL.HPCTRL)
        end

        GodModeController.SetCurrentHP(
            LocalPlayer,
            GodModeController.GetMaxHP(LocalPlayer)
        )
    end)
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 3: Super Loot Boss Hunter (Auto Sniper)
-- ─────────────────────────────────────────────────────────────
local huntedBosses = {}
local function checkSuperLootHunter()
    if not State.SuperLootHunter then return end
    local superLootFolder = workspace:FindFirstChild("SuperLootFolder")
    if not superLootFolder or #superLootFolder:GetChildren() == 0 then return end

    for _, bossVal in ipairs(superLootFolder:GetChildren()) do
        local bossRarity = bossVal.Name
        if State.SuperLootTargetTier == "All" or State.SuperLootTargetTier == bossRarity then
            local enemyFolder = workspace:FindFirstChild("EnemyFolder")
            local targetBossModel = nil
            if enemyFolder then
                for _, e in ipairs(enemyFolder:GetChildren()) do
                    if e:GetAttribute("EnemyID") and tostring(e:GetAttribute("EnemyID")):find("Super") then
                        targetBossModel = e
                        break
                    end
                end
            end

            if targetBossModel and targetBossModel.PrimaryPart and not huntedBosses[targetBossModel] then
                Stats.CurrentActivity = TF("StatusSuperLootHunt", bossRarity)
                notify(
                    LT("ล่าบอสแร่ยักษ์", "Super Loot Hunter"),
                    TF("Notif_BossAcquired", bossRarity),
                    "crosshair"
                )

                if State.NotifySuperLoot then
                    local isTH = State.Language == "TH"
                    sendWebhook(
                        isTH and "ตรวจพบบอสแร่ยักษ์เป้าหมาย!" or "Super Loot Target Engaged",
                        isTH and "ระบบสไนป์บอสเข้าโจมตีและเก็บเกี่ยวของรางวัลเรียบร้อย" or "Autonomous sniper intercepted active Super Loot.",
                        {
                            { name = isTH and "ระดับความหายาก" or "Tier / Rarity", value = bossRarity, inline = true },
                            { name = isTH and "พิกัดเป้าหมาย" or "Coordinates", value = tostring(targetBossModel.PrimaryPart.Position), inline = true },
                        },
                        0xEF4444
                    )
                end

                tpTo(targetBossModel.PrimaryPart.CFrame + Vector3.new(0, 8, 0))
                task.wait(0.2)
                runKillAura()
                call("SuperLoot", "KillSuperLootRE", targetBossModel.Name)
                Stats.SuperLootKills = Stats.SuperLootKills + 1
                huntedBosses[targetBossModel] = true

                task.wait(0.5)
                runDropMagnet()
                runUltraPrompts()
                break
            end
        end
    end
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 4: Dungeon & Stage Loop (เลือกได้สูงสุด 3 ด่าน + ไต่ด่าน)
-- ─────────────────────────────────────────────────────────────
local function runDungeonLoop(force)
    if not (force or State.AutoDungeon) then return end
    if checkSafeEvacuate() then return end

    local isDungeoning = LocalPlayer:GetAttribute("Dungeoning")
    if not isDungeoning then
        Stats.CurrentActivity = TF("StatusDungeonEnter", tostring(State.DungeonRound))
        if State.AutoClaimTicket then
            call("Dungeon", "TryClaimDailyDunTicRE")
        end
        local ok = call("Dungeon", "TryIntoDungeonRF", State.DungeonRound)
        task.wait(1)
        if ok or LocalPlayer:GetAttribute("Dungeoning") then
            call("Dungeon", "StartRoundRE", State.DungeonRound)
        end
    else
        Stats.CurrentActivity = T("StatusDungeonWave")
        instantKillAll(true)
        if State.DropMagnet then runDropMagnet() end
        if State.UltraPrompt then runUltraPrompts() end
        runSafeFlight()
    end
end

local StageRuntime = { idx = 1, clears = 0, emptySince = nil }

local function activeStageList()
    local list = {}
    if type(State.FarmStages) == "table" then
        for _, s in ipairs(State.FarmStages) do
            if table.find(Dynamic.Stages, s) and #list < 3 then table.insert(list, s) end
        end
    end
    if #list == 0 then list[1] = State.SelectedStage or Dynamic.Stages[1] end
    return list
end

local function currentFarmStage()
    if State.AutoClimbStages then return State.SelectedStage end
    local list = activeStageList()
    if StageRuntime.idx > #list then StageRuntime.idx = 1 end
    return list[StageRuntime.idx]
end

local function onStageCleared()
    Stats.LastStageClear = os.time()

    if State.AutoClimbStages then
        local i = table.find(Dynamic.Stages, State.SelectedStage) or 1
        if i < #Dynamic.Stages then
            State.SelectedStage = Dynamic.Stages[i + 1]
            notify(LT("เลื่อนระดับด่าน", "Stage Advance"), TF("Notif_StageAdvance", State.SelectedStage), "arrow-up-right")
        end
        return
    end

    StageRuntime.clears = StageRuntime.clears + 1
    local list = activeStageList()
    if #list > 1 and StageRuntime.clears >= (State.StageRotateClears or 3) then
        StageRuntime.clears = 0
        StageRuntime.idx = (StageRuntime.idx % #list) + 1
        notify(LT("สลับด่านฟาร์ม", "Stage Rotate"), TF("Notif_StageAdvance", list[StageRuntime.idx]), "repeat")
    end
end

local function runStageLoop(force)
    if not (force or State.AutoStage) then return end
    if LocalPlayer:GetAttribute("Dungeoning") then return end
    if checkSafeEvacuate() then return end

    local target = currentFarmStage()
    local intoFight = LocalPlayer:GetAttribute("IntoFight")

    -- ยังไม่อยู่ในด่าน หรืออยู่ผิดด่าน -> สั่งเข้าด่านเป้าหมายทันที
    if (not intoFight) or LocalPlayer:GetAttribute("StageID") ~= target then
        Stats.CurrentActivity = TF("StatusStageEnter", target)
        LocalPlayer:SetAttribute("StageID", target)
        Stats.LastStageClear = os.time()
        StageRuntime.emptySince = nil
        task.wait(0.5)
        return
    end

    Stats.CurrentActivity = TF("StatusStageFight", target)
    instantKillAll(true)
    if State.DropMagnet then runDropMagnet() end
    if State.UltraPrompt then runUltraPrompts() end
    runSafeFlight()

    local remaining = #getEnemies()
    if remaining == 0 then
        StageRuntime.emptySince = StageRuntime.emptySince or os.clock()
        if os.clock() - StageRuntime.emptySince >= 2.0 then
            StageRuntime.emptySince = nil
            onStageCleared()
            task.wait(0.5)
        end
    else
        StageRuntime.emptySince = nil
        -- ไต่ด่าน: ตีไม่ทันเวลา ถอยกลับ 1 ด่าน
        if State.AutoClimbStages and os.time() - Stats.LastStageClear > State.StageClimbTimeout then
            local i = table.find(Dynamic.Stages, State.SelectedStage) or 1
            if i > 1 then
                State.SelectedStage = Dynamic.Stages[i - 1]
                Stats.LastStageClear = os.time()
                notify(LT("ถอยกลับด่านเดิม", "Stage Retreat"), TF("Notif_StageRetreat", State.SelectedStage), "shield-alert")
                call("Stage", "ClaimedAllOreRE")
                tpTo(getSafeZoneCF())
                task.wait(1.5)
            end
        end
    end
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 5: Class Gacha (สุ่มจนเจอ), Skills, Potions, Eggs
-- ─────────────────────────────────────────────────────────────
local ClassRoll = { rolls = 0 }

local function collectStrings(v, out, depth)
    if type(v) == "string" then
        out[v] = true
    elseif type(v) == "table" and depth < 3 then
        for _, x in pairs(v) do collectStrings(x, out, depth + 1) end
    end
end

local function readCurrentClasses()
    local set = {}
    pcall(function()
        local ClassData = require(ReplicatedStorage.LocalData.ClassData)
        if type(ClassData.GetEquipedClass) == "function" then
            collectStrings(ClassData.GetEquipedClass(), set, 0)
        end
        for name, fn in pairs(ClassData) do
            if type(fn) == "function" and type(name) == "string" and name:find("^Get") and name:find("Index") then
                for _, arg in ipairs({ "1", 1 }) do
                    local ok, r = pcall(fn, arg)
                    if ok then collectStrings(r, set, 0) end
                end
            end
        end
    end)
    return set
end

local function targetClassList()
    if type(State.TargetClasses) == "table" and #State.TargetClasses > 0 then
        return State.TargetClasses
    end
    return { State.TargetClassToLock }
end

local function matchedTarget(set, targets)
    for _, t in ipairs(targets) do
        if set[t] then return t end
    end
    return nil
end

local function runClassRoll()
    if not State.AutoRollClass then return end
    local targets = targetClassList()
    local set = readCurrentClasses()
    local hit = matchedTarget(set, targets)

    if not hit then
        local cur = "-"
        for k in pairs(set) do cur = k break end
        ClassRoll.rolls = ClassRoll.rolls + 1
        Stats.CurrentActivity = TF("StatusRollClass", cur) .. " #" .. ClassRoll.rolls
        call("Class", "LuckOnceRE", "1")
        task.wait(0.3)
        hit = matchedTarget(readCurrentClasses(), targets)
    end

    if hit then
        call("Class", "SetIndexLockRE", "1")
        call("Class", "ChangeEquipedIndexRE", "1")
        State.AutoRollClass = false
        notify(LT("สุ่มคลาสสำเร็จ", "Class Gacha"), TF("Notif_ClassLocked", hit) .. " (" .. ClassRoll.rolls .. ")", "check-circle")
        ClassRoll.rolls = 0
    end
end

local function runSkillRoll()
    if State.AutoRollSkills then
        call("Backpack", "LuckSkillCell_2RE")
    end
end

local function runPotions()
    if not State.AutoUsePotions then return end
    pcall(function()
        local BuffData = require(ReplicatedStorage.LocalData.BuffData)
        for _, pot in ipairs(Dynamic.Potions) do
            if not BuffData.IsHaveBuff(pot) then
                call("Potion", "TryUsePotionRE", pot)
                task.wait(0.1)
            end
        end
    end)
end

local function runHatch()
    if State.AutoHatchEggs then
        call("Egg", "PutEggRE")
    end
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 6: Forge (เลือกไอเทมเป้าหมาย หลอมซ้ำจนได้)
-- ─────────────────────────────────────────────────────────────
local ForgeState = { tries = 0, baseline = nil }

local function resultString(v, depth)
    if type(v) == "string" then return v end
    if type(v) == "number" or type(v) == "boolean" then return tostring(v) end
    if type(v) == "table" and depth < 3 then
        local t = {}
        for k, x in pairs(v) do
            t[#t + 1] = tostring(k) .. "=" .. resultString(x, depth + 1)
        end
        return table.concat(t, " ")
    end
    return ""
end

local function inventoryCount(name)
    local best = 0
    pcall(function()
        local BackpackData = require(ReplicatedStorage.LocalData.BackpackData)
        for _, kind in ipairs({ "Equipment", "Equip", "Weapon", "Item", "Material" }) do
            local ok, d = pcall(BackpackData.GetItemDataByIDType, name, kind)
            if ok and type(d) == "table" then
                local n = d.Number or d.Count or 1
                if type(n) == "number" and n > best then best = n end
            end
        end
    end)
    return best
end

local function forgeInfoFor(name)
    for _, src in ipairs(Dynamic.ForgeSources) do
        local entry = type(src.cfg) == "table" and src.cfg[name] or nil
        if entry ~= nil then
            return src.name .. ": " .. resultString(entry, 0)
        end
    end
    return nil
end

local function finishForge(target)
    State.AutoForge = false
    ForgeState.baseline = nil
    Stats.CurrentActivity = "StatusReady"
    notify(LT("หลอมสำเร็จ", "Forge Complete"), LT("ได้ไอเทมเป้าหมายแล้ว: ", "Target obtained: ") .. tostring(target) .. " (" .. ForgeState.tries .. ")", "hammer")
    local isTH = State.Language == "TH"
    sendWebhook(
        isTH and "หลอมได้ไอเทมเป้าหมาย" or "Forge Target Obtained",
        tostring(target),
        { { name = isTH and "จำนวนครั้งที่หลอม" or "Attempts", value = tostring(ForgeState.tries), inline = true } },
        0xF59E0B
    )
end

local function runAutoForge()
    local targets = State.ForgeTargets
    local hasTargets = type(targets) == "table" and #targets > 0

    if hasTargets and not ForgeState.baseline then
        ForgeState.baseline = {}
        ForgeState.tries = 0
        for _, t in ipairs(targets) do ForgeState.baseline[t] = inventoryCount(t) end
    end

    local res
    if hasTargets and State.ForgePassTarget then
        res = call("Forge", "ForgeRF", targets[1])
    else
        res = call("Forge", "ForgeRF")
    end
    if not hasTargets then return end

    ForgeState.tries = ForgeState.tries + 1
    Stats.CurrentActivity = LT("กำลังหลอมหาไอเทมเป้าหมาย รอบที่ ", "Forging for target, attempt ") .. ForgeState.tries

    local text = resultString(res, 0):lower()
    for _, t in ipairs(targets) do
        local found = text:find(tostring(t):lower(), 1, true)
            or inventoryCount(t) > (ForgeState.baseline[t] or 0)
        if found then
            finishForge(t)
            return
        end
    end

    if ForgeState.tries >= (State.ForgeMaxTries or 300) then
        State.AutoForge = false
        ForgeState.baseline = nil
        Stats.CurrentActivity = "StatusReady"
        notify(LT("หยุดหลอม", "Forge Stopped"), LT("หลอมครบจำนวนครั้งที่ตั้งไว้แล้ว", "Reached max attempts"), "alert-triangle")
    end
end

local function promptContextText(p)
    local parts = { p.Name, p.ActionText, p.ObjectText }
    local a = p.Parent
    for _ = 1, 4 do
        if a and a ~= workspace and a ~= game then
            table.insert(parts, a.Name)
            a = a.Parent
        end
    end
    return table.concat(parts, " "):lower()
end

local function findForgePrompt()
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            local t = promptContextText(p)
            if t:find("forge", 1, true) or t:find("furnace", 1, true) or t:find("smelt", 1, true)
                or t:find("เตา", 1, true) or t:find("หลอม", 1, true) then
                return p
            end
        end
    end
    return nil
end

local function forgePromptPart(p)
    local part = p.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if part and part:IsA("BasePart") then return part end
    if part and part:IsA("Model") then return part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end

-- เปิดหน้าเตาหลอมด้วยตัวเอง (กดปุ่มนี้เท่านั้น ไม่ถูกเรียกจากระบบอื่น)
local function openForgePage()
    local p = findForgePrompt()
    if not p then return false end
    if not fireproximityprompt then return false end
    pcall(function()
        p.MaxActivationDistance = 1e6
        p.RequiresLineOfSight = false
        p.HoldDuration = 0
        fireproximityprompt(p, 0)
    end)
    return true
end

local function teleportToForge()
    local p = findForgePrompt()
    local part = p and forgePromptPart(p)
    if part then
        tpTo(part.CFrame + Vector3.new(0, 0, 5))
        return true
    end
    return false
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 7: Promo Codes (ระบบหาโค้ดเอง)
-- ─────────────────────────────────────────────────────────────
local CodeSources = {
    "https://rocodes.gg/codes/1-loot-to-forge",
    "https://robloxden.com/game-codes/1-loot-to-forge",
    "https://creatorexchange.io/roblox-game/10684750879/1-loot-to-forge",
}
-- สำรองไว้เผื่อโหลดเว็บไม่ได้ (โค้ดล่าสุด ณ 30 ก.ย. 2026 โค้ดเก่าอาจหมดอายุแล้ว)
local FallbackCodes = { "50000CCU", "30000CCU", "20000CCU" }

local function httpGetSafe(url)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if req then
        local ok2, res = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(res) == "table" and type(res.Body) == "string" then return res.Body end
    end
    return nil
end

local function findAllCodes()
    local list, seen = {}, {}
    local function add(c)
        if c and not seen[c] then
            seen[c] = true
            table.insert(list, c)
        end
    end

    for _, c in ipairs(Dynamic.GameCodes) do add(c) end

    for _, url in ipairs(CodeSources) do
        local body = httpGetSafe(url)
        if body then
            for c in body:gmatch('"name"%s*:%s*"([A-Z0-9_]+)"') do
                if #c >= 4 and #c <= 24 then add(c) end
            end
            for c in body:gmatch("%f[%w](%d+CCU)%f[%W]") do add(c) end
        end
    end

    for _, c in ipairs(FallbackCodes) do add(c) end
    return list
end

local function redeemAllCodes()
    local codes = findAllCodes()
    local lines = {}
    for _, c in ipairs(codes) do
        local res = call("Code", "TryUseCodeRF", c)
        local line = c .. " -> " .. resultString(res, 0)
        table.insert(lines, line)
        print("[Aetherix Codes]", line)
        task.wait(0.4)
    end
    local preview = {}
    for i = 1, math.min(#lines, 4) do preview[#preview + 1] = lines[i] end
    notify(
        LT("ค้นหาโค้ดอัตโนมัติ", "Auto Codes"),
        LT("ลองโค้ดทั้งหมด ", "Tried codes: ") .. #codes .. "\n" .. table.concat(preview, "\n"),
        "ticket"
    )
    return codes
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 8: Warp (เลือกจุดวาร์ปได้)
-- ─────────────────────────────────────────────────────────────
local WarpOptions = {}

local function stageDisplay(s)
    local n = tostring(s):match("%d+")
    if n then return LT("ด่าน ", "Stage ") .. n end
    return tostring(s)
end

local function buildWarpOptions()
    WarpOptions = {
        { id = "safe",    label = LT("โซนปลอดภัย (จุดเกิด)", "Safe Zone (Spawn)") },
        { id = "train",   label = LT("พื้นที่ฝึกพลัง (Train Map)", "Train Map") },
        { id = "dungeon", label = LT("ทางเข้าดันเจี้ยน", "Dungeon Entrance") },
    }
    for _, s in ipairs(Dynamic.Stages) do
        table.insert(WarpOptions, { id = "stage:" .. s, label = stageDisplay(s) })
    end
    for _, a in ipairs(Dynamic.TrainAreas) do
        table.insert(WarpOptions, { id = "area:" .. a, label = LT("โซนฝึกพลัง ", "Train Zone ") .. a .. LT(" (เริ่มฝึกทันที)", " (starts training)") })
    end
end

local function warpLabels()
    local out = {}
    for _, o in ipairs(WarpOptions) do table.insert(out, o.label) end
    return out
end

local function warpLabelForId(id)
    for _, o in ipairs(WarpOptions) do
        if o.id == id then return o.label end
    end
    return WarpOptions[1] and WarpOptions[1].label or ""
end

local function warpIdForLabel(label)
    for _, o in ipairs(WarpOptions) do
        if o.label == label then return o.id end
    end
    return "safe"
end

local function warpTo(id)
    if id == "safe" then
        tpTo(getSafeZoneCF())
        return true
    elseif id == "train" then
        local tm = workspace:FindFirstChild("WorldModel") and workspace.WorldModel:FindFirstChild("TrainMap")
        if tm then tpTo(tm:GetPivot()) return true end
        return false
    elseif id == "dungeon" then
        local dm = workspace:FindFirstChild("WorldModel") and workspace.WorldModel:FindFirstChild("DungeonMap")
        local sp = dm and dm:FindFirstChild("StartPoint")
        if sp then tpTo(sp.CFrame) return true end
        return false
    elseif id:sub(1, 6) == "stage:" then
        local name = id:sub(7)
        LocalPlayer:SetAttribute("StageID", name)
        Stats.CurrentActivity = TF("StatusStageEnter", name)
        for _ = 1, 20 do
            if LocalPlayer:GetAttribute("IntoFight") then break end
            task.wait(0.3)
        end
        instantKillAll(true)
        return true
    elseif id:sub(1, 5) == "area:" then
        local area = id:sub(6)
        State.TrainArea = area
        call("Train", "IntoAutoTrainRE", tonumber(area) or 1)
        return true
    end
    return false
end

-- ─────────────────────────────────────────────────────────────
-- Core Engine 9: Master 24/7 Automation Loop
-- ─────────────────────────────────────────────────────────────
local LastClaimTick = 0

local function runMaster247Engine()
    if not State.Master247 then return end

    if checkSafeEvacuate() then
        task.wait(1)
        return
    end

    if State.SuperLootHunter then
        checkSuperLootHunter()
    end

    -- เคลมรางวัลออฟไลน์/ตั๋วรายวัน ทุก 90 วินาที (ไม่ยิงถี่เหมือนเดิม)
    if os.clock() - LastClaimTick > 90 then
        LastClaimTick = os.clock()
        pcall(function()
            call("Offline", "TryClaimOfflineRewardRE")
            call("Dungeon", "TryClaimDailyDunTicRE")
        end)
    end

    if State.FarmMode == "Dungeon" then
        local hasTickets = false
        pcall(function()
            local BackpackData = require(ReplicatedStorage.LocalData.BackpackData)
            local t = BackpackData.GetItemDataByIDType("Dungeon_Ticket", "Material")
            if t and t.Number and t.Number > 0 then hasTickets = true end
        end)

        if hasTickets or LocalPlayer:GetAttribute("Dungeoning") then
            runDungeonLoop(true)
        elseif State.MasterTrainWhenIdle then
            Stats.CurrentActivity = TF("StatusTrain", tostring(State.TrainArea))
            call("Train", "TrainOnceRE")
        else
            runStageLoop(true)
        end
    else
        runStageLoop(true)
    end

    -- เก็บแร่ตามตัวกรองที่เลือก (ปลอดภัย: ยิงเฉพาะ prompt ของดรอป)
    if State.MasterCollect then
        runDropMagnet()
        runUltraPrompts()
    end
end

local function claimAllRewards()
    call("Offline", "TryClaimOfflineRewardRE")
    for i = 1, 12 do
        call("Online", "TryClaimRE", i)
        task.wait(0.05)
    end
    call("UpdateLog", "TryClaimUPDRewardRE")
    call("Dungeon", "TryClaimDailyDunTicRE")
    call("EnhantEvent", "TryClaimQuestRE")
    call("Index", "TryClaimIndexExpRF")
    call("Index", "TryClaimLevelRewardRF")
end


-- ─────────────────────────────────────────────────────────────
-- Theme Presets & UI Construction
-- ─────────────────────────────────────────────────────────────
local ThemePresets = {
    Aetherix  = { "#8B5CF6", "#0E0B18", "#14101F", "#A78BFA", "#F5F3FF", "#9088B0", "#2A2145", "#C4B5FD" },
    NeonCyan  = { "#06B6D4", "#06121A", "#0B1D28", "#22D3EE", "#ECFEFF", "#7FA6B3", "#12384A", "#67E8F9" },
    Sakura    = { "#F472B6", "#1A0B14", "#26101D", "#F9A8D4", "#FDF2F8", "#B58AA0", "#4A1D37", "#FBCFE8" },
    Crimson   = { "#EF4444", "#160909", "#211010", "#F87171", "#FEF2F2", "#B08A8A", "#451A1A", "#FCA5A5" },
    Emerald   = { "#10B981", "#07140F", "#0D211A", "#34D399", "#ECFDF5", "#7FB3A0", "#134232", "#6EE7B7" },
    RoyalGold = { "#F59E0B", "#150F05", "#211808", "#FBBF24", "#FFFBEB", "#B39A6B", "#4A3410", "#FCD34D" },
}
local ThemeOrder = { "Aetherix", "NeonCyan", "Sakura", "Crimson", "Emerald", "RoyalGold" }

-- ธีมเพิ่มเติม สร้างอัตโนมัติจากสีหลัก (รวมเป็น 26 ธีม + Dark/Light ของ WindUI)
local ExtraAccents = {
    { "Ocean", "#3B82F6" },    { "Sunset", "#FB923C" },   { "Lavender", "#C084FC" },
    { "Mint", "#2DD4BF" },     { "Toxic", "#84CC16" },    { "Ruby", "#E11D48" },
    { "Amber", "#EAB308" },    { "Ice", "#7DD3FC" },      { "Coral", "#FB7185" },
    { "Indigo", "#6366F1" },   { "Teal", "#14B8A6" },     { "Magenta", "#D946EF" },
    { "Lime", "#A3E635" },     { "Orange", "#F97316" },   { "Sky", "#0EA5E9" },
    { "Violet", "#7C3AED" },   { "Peach", "#FDBA74" },    { "Slate", "#94A3B8" },
    { "Mocha", "#A98467" },    { "Cherry", "#BE123C" },
}

for _, pair in ipairs(ExtraAccents) do
    local accent = Color3.fromHex(pair[2])
    local h, s = accent:ToHSV()
    ThemePresets[pair[1]] = {
        accent,
        Color3.fromHSV(h, math.min(s, 0.7) * 0.7, 0.07),
        Color3.fromHSV(h, math.min(s, 0.7) * 0.6, 0.12),
        Color3.fromHSV(h, s * 0.55, 1),
        Color3.fromHSV(h, 0.05, 1),
        Color3.fromHSV(h, 0.2, 0.7),
        Color3.fromHSV(h, math.min(s, 0.8) * 0.7, 0.26),
        Color3.fromHSV(h, s * 0.4, 1),
    }
    table.insert(ThemeOrder, pair[1])
end

local function themeColor(c)
    if typeof(c) == "Color3" then return c end
    return Color3.fromHex(c)
end

local StatusCard, StatsCard, BagCard
local BuildUI
local BuildingUI = false

BuildUI = function()
    if BuildingUI then return end
    BuildingUI = true

    if CurrentWindow then
        pcall(function() CurrentWindow:Destroy() end)
        CurrentWindow = nil
    end

    local hui = gethui and gethui() or game:GetService("CoreGui")
    for _, c in ipairs(hui:GetChildren()) do
        if c.Name:find("WindUI") then pcall(function() c:Destroy() end) end
    end
    local rg = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
    if rg then
        for _, c in ipairs(rg:GetChildren()) do
            if c.Name:find("WindUI") then pcall(function() c:Destroy() end) end
        end
    end

    local WindUI = loadstring(game:HttpGet(
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
    ))()
    CurrentWindUI = WindUI

    local registered = { Dark = true, Light = true }
    for name, c in pairs(ThemePresets) do
        local ok = pcall(function()
            WindUI:AddTheme({
                Name        = name,
                Accent      = themeColor(c[1]), Background  = themeColor(c[2]),
                Dialog      = themeColor(c[3]), Outline     = themeColor(c[4]),
                Text        = themeColor(c[5]), Placeholder = themeColor(c[6]),
                Button      = themeColor(c[7]), Icon        = themeColor(c[8]),
            })
        end)
        registered[name] = ok
    end
    local startTheme = registered[State.Theme] and State.Theme or (registered.Aetherix and "Aetherix" or "Dark")
    State.Theme = startTheme

    local Window = WindUI:CreateWindow({
        Title        = T("WindowTitle"),
        Icon         = "sparkles",
        Author       = T("WindowSub"),
        Folder       = "AetherixHub",
        Size         = UDim2.fromOffset(680, 530),
        Theme        = startTheme,
        Transparent  = State.Transparency,   -- v3.3: โปร่งใสตั้งแต่เปิด (ปิดเองได้ในหน้าตั้งค่า)
        SideBarWidth = 215,
        HasOutline   = true,
        User         = { Enabled = false },
    })
    CurrentWindow = Window

    pcall(function() Window:SetToggleKey(Enum.KeyCode.RightShift) end)
    pcall(function()
        Window:EditOpenButton({
            Title        = T("WindowTitle"),
            Icon         = "sparkles",
            CornerRadius = UDim.new(0, 16),
            StrokeThickness = 2,
            Color        = ColorSequence.new(Color3.fromHex("#8B5CF6"), Color3.fromHex("#06B6D4")),
            Draggable    = true,
        })
    end)
    pcall(function() Window:Tag({ Title = T("VersionTag"), Color = Color3.fromHex("#8B5CF6") }) end)

    buildWarpOptions()

    -- ═════════════════════════════════════════════════════════════
    --  TAB 1: Dashboard 24/7 (Live Monitoring & Master AI)
    -- ═════════════════════════════════════════════════════════════
    local T1 = Window:Tab({ Title = T("Tab1"), Icon = "layout-dashboard" })

    T1:Section({ Title = T("Sec_Master") })

    T1:Toggle({
        Title = T("Tgl_Master247"),
        Desc  = T("Desc_Master247"),
        Value = State.Master247,
        Callback = function(v)
            -- v3.3: ไม่แอบเปิดฟังก์ชันอื่นเองอีกต่อไป (เดิมแอบเปิดอพยพ+ขาย+ดูดของ)
            State.Master247 = v
            if v then
                notify("Master 24/7", T("Notif_MasterEngaged"), "zap")
            else
                Stats.CurrentActivity = "StatusPaused"
            end
        end,
    })

    T1:Section({ Title = LT("ตั้งค่าโหมดฟาร์ม 24/7", "24/7 Farm Setup") })

    local modeLabels = {
        Stage   = LT("ไต่ด่านเก็บแร่ (Stage)", "Stage Climb / Ore Farm"),
        Dungeon = LT("ดันเจี้ยน (Dungeon)", "Dungeon"),
    }
    T1:Dropdown({
        Title = LT("เลือกโหมดฟาร์ม", "Farm Mode"),
        Desc  = LT("เลือกว่าโหมด 24/7 จะฟาร์มดันเจี้ยน หรือไต่ด่านเก็บแร่ (วาร์ปไปฆ่าทันทีทั้งสองโหมด)", "Choose Dungeon or Stage ore farming (instant-kill warp in both)"),
        Values = { modeLabels.Stage, modeLabels.Dungeon },
        Value = modeLabels[State.FarmMode] or modeLabels.Stage,
        Callback = function(v)
            State.FarmMode = (v == modeLabels.Dungeon) and "Dungeon" or "Stage"
        end,
    })

    local stageDD
    stageDD = T1:Dropdown({
        Title = LT("เลือกด่านที่จะฟาร์ม (สูงสุด 3 ด่าน)", "Stages to Farm (max 3)"),
        Desc  = LT("เลือก 1-3 ด่าน ระบบจะวนฟาร์มตามลำดับที่เลือก", "Pick 1-3 stages; the bot rotates through them"),
        Values = Dynamic.Stages,
        Multi = true,
        AllowNone = true,
        Value = State.FarmStages,
        Callback = function(v)
            local list = type(v) == "table" and v or { v }
            local trimmed = {}
            for _, s in ipairs(list) do
                if #trimmed < 3 then table.insert(trimmed, s) end
            end
            if #list > 3 then
                notify(LT("เลือกด่าน", "Stages"), LT("เลือกได้สูงสุด 3 ด่าน", "Maximum 3 stages"), "alert-triangle")
                pcall(function() stageDD:Select(trimmed) end)
            end
            State.FarmStages = trimmed
            if trimmed[1] then State.SelectedStage = trimmed[1] end
            StageRuntime.idx = 1
            StageRuntime.clears = 0
        end,
    })

    T1:Slider({
        Title = LT("เคลียร์กี่รอบก่อนสลับด่านถัดไป", "Clears Before Switching Stage"),
        Value = { Min = 1, Max = 10, Default = State.StageRotateClears },
        Callback = function(v) State.StageRotateClears = v end,
    })

    T1:Dropdown({
        Title = LT("เลือกแร่ที่จะเก็บ (ไม่เลือก = เก็บทุกแร่)", "Ores to Collect (none = all)"),
