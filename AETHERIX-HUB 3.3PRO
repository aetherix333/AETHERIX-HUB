    -- ═════════════════════════════════════════════════════════════
    --  TAB 5: Train & Upgrades (Stat Progression)
    -- ═════════════════════════════════════════════════════════════
    local T5 = Window:Tab({ Title = T("Tab5"), Icon = "zap" })

    T5:Section({ Title = T("Sec_Train") })

    T5:Dropdown({
        Title = T("Drop_TrainArea"),
        Desc  = T("Desc_TrainArea"),
        Values = Dynamic.TrainAreas,
        Value = State.TrainArea,
        Callback = function(v) State.TrainArea = v end,
    })

    T5:Toggle({
        Title = T("Tgl_AutoTrain"),
        Desc  = T("Desc_AutoTrain"),
        Value = State.AutoTrain,
        Callback = toggleLoop("AutoTrain", "TrainDelay", function()
            call("Train", "TrainOnceRE")
        end),
    })

    T5:Slider({
        Title = T("Sld_TrainDelay"),
        Value = { Min = 0.05, Max = 1.5, Default = State.TrainDelay },
        Callback = function(v) State.TrainDelay = v end,
    })

    T5:Toggle({
        Title = T("Tgl_NativeAutoTrain"),
        Desc  = T("Desc_NativeAutoTrain"),
        Value = State.AutoTrainMode,
        Callback = function(v)
            State.AutoTrainMode = v
            if v then call("Train", "IntoAutoTrainRE", tonumber(State.TrainArea) or 1)
            else      call("Train", "ExitAutoTrainRE") end
        end,
    })

    T5:Section({ Title = T("Sec_Upgrade") })

    T5:Dropdown({
        Title = T("Drop_UpgradeType"),
        Desc  = T("Desc_UpgradeType"),
        Values = { T("Opt_UpgradeAll"), "Train", "OrePack", "Luck" },
        Value = (State.UpgradeType == "All in One" and T("Opt_UpgradeAll") or State.UpgradeType),
        Callback = function(o)
            if o:find("All") or o:find("ทั้งหมด") then
                State.UpgradeType = "All in One"
            else
                State.UpgradeType = o
            end
        end,
    })

    T5:Toggle({
        Title = T("Tgl_AutoUpgrade"),
        Desc  = T("Desc_AutoUpgrade"),
        Value = State.AutoUpgrade,
        Callback = toggleLoop("AutoUpgrade", "UpgradeDelay", function()
            if State.UpgradeType == "All in One" then
                call("Upgrade", "UpgradeOnceRE", "Train")
                call("Upgrade", "UpgradeOnceRE", "OrePack")
                call("Upgrade", "UpgradeOnceRE", "Luck")
            else
                call("Upgrade", "UpgradeOnceRE", State.UpgradeType)
            end
        end),
    })

    T5:Slider({
        Title = T("Sld_UpgradeDelay"),
        Value = { Min = 0.5, Max = 5.0, Default = State.UpgradeDelay },
        Callback = function(v) State.UpgradeDelay = v end,
    })

    T5:Section({ Title = T("Sec_Rebirth") })

    T5:Toggle({
        Title = T("Tgl_AutoRebirth"),
        Desc  = T("Desc_AutoRebirth"),
        Value = State.AutoRebirth,
        Callback = toggleLoop("AutoRebirth", "RebirthDelay", function()
            call("Rebirth", "TryRebirthRE")
            Stats.RebirthCount = Stats.RebirthCount + 1
        end),
    })

    T5:Slider({
        Title = T("Sld_RebirthDelay"),
        Value = { Min = 2, Max = 60, Default = State.RebirthDelay },
        Callback = function(v) State.RebirthDelay = v end,
    })

    T5:Toggle({
        Title = T("Tgl_NativeRebirth"),
        Value = State.NativeAutoRebirth,
        Callback = function(v)
            State.NativeAutoRebirth = v
            call("Rebirth", "UpdateAutoRebirthRE", v)
        end,
    })


    -- ═════════════════════════════════════════════════════════════
    --  TAB 6: Forge & Equipment (Crafting & Gear)
    -- ═════════════════════════════════════════════════════════════
    local T6 = Window:Tab({ Title = T("Tab6"), Icon = "hammer" })

    T6:Section({ Title = T("Sec_Forge") })

    T6:Button({
        Title = LT("เปิดหน้าเตาหลอม", "Open Forge Page"),
        Desc  = LT("เปิดหน้าต่างเตาหลอมของเกม (ทำงานเฉพาะตอนกดปุ่มนี้)", "Opens the game's forge window (only when you press this)"),
        Callback = function()
            once("OpenForge", 0.8, function()
                if openForgePage() then
                    notify(LT("เตาหลอม", "Forge"), LT("สั่งเปิดหน้าเตาหลอมแล้ว", "Forge page opened"), "hammer")
                else
                    notify(LT("เตาหลอม", "Forge"), LT("ไม่พบเตาหลอมในแมพ ลองกดปุ่มวาร์ปไปเตาหลอม", "Forge not found; try warping to it first"), "alert-triangle")
                end
            end)
        end,
    })

    T6:Button({
        Title = LT("วาร์ปไปหน้าเตาหลอม", "Warp to Forge"),
        Callback = function()
            once("TpForge", 0.8, function()
                if teleportToForge() then
                    notify(LT("เตาหลอม", "Forge"), LT("วาร์ปถึงเตาหลอมแล้ว", "Arrived at forge"), "map-pin")
                else
                    notify(LT("เตาหลอม", "Forge"), LT("ไม่พบตำแหน่งเตาหลอม", "Forge location not found"), "alert-triangle")
                end
            end)
        end,
    })

    local forgeInfoCard = T6:Paragraph({
        Title = LT("ข้อมูลไอเทมเป้าหมาย", "Target Info"),
        Desc  = Dynamic.ForgeItemsAreFallback
            and LT("ไม่พบรายการไอเทมในคอนฟิกเกม จึงใช้ระดับความหายากแทน (ระบบจะหยุดเมื่อผลลัพธ์/กระเป๋ามีคำนั้น)", "Game forge config not found; using rarity keywords instead")
            or LT("เลือกไอเทมด้านล่างเพื่อดูข้อมูลสูตรจากเกม", "Select a target below to view game recipe data"),
    })

    local function refreshForgeInfo()
        local t = State.ForgeTargets
        local text
        if type(t) == "table" and t[1] then
            text = forgeInfoFor(t[1])
        end
        pcall(function()
            forgeInfoCard:SetDesc(text and text:sub(1, 400) or LT("ไม่มีข้อมูลสูตรของไอเทมนี้ในคอนฟิก", "No recipe data found for this target"))
        end)
        return text
    end

    T6:Dropdown({
        Title = LT("เลือกไอเทมที่อยากได้จากการหลอม", "Forge Target Item(s)"),
        Desc  = LT("ไม่เลือก = หลอมธรรมดา / เลือกแล้วจะหลอมซ้ำจนได้ไอเทมนั้น", "None = plain forging; selected = keep forging until obtained"),
        Values = Dynamic.ForgeItems,
        Multi = true,
        AllowNone = true,
        Value = State.ForgeTargets,
        Callback = function(v)
            State.ForgeTargets = type(v) == "table" and v or { v }
            ForgeState.baseline = nil
            refreshForgeInfo()
        end,
    })

    T6:Button({
        Title = LT("ดูข้อมูลสูตรของไอเทมเป้าหมาย", "Show Target Recipe Data"),
        Callback = function()
            local text = refreshForgeInfo()
            print("[Aetherix Forge] sources:", #Dynamic.ForgeSources, "items:", #Dynamic.ForgeItems)
            for _, src in ipairs(Dynamic.ForgeSources) do
                print("[Aetherix Forge] config folder:", src.name)
            end
            if text then print("[Aetherix Forge] recipe:", text) end
            notify(LT("ข้อมูลสูตร", "Recipe"), text and text:sub(1, 180) or LT("ไม่พบข้อมูลสูตร (ดู Console)", "No recipe data (see console)"), "book-open")
        end,
    })

    T6:Slider({
        Title = LT("จำนวนครั้งสูงสุดที่จะหลอมหาไอเทม", "Max Forge Attempts"),
        Value = { Min = 10, Max = 2000, Default = State.ForgeMaxTries },
        Callback = function(v) State.ForgeMaxTries = v end,
    })

    T6:Toggle({
        Title = LT("ส่งชื่อไอเทมเป้าหมายไปกับคำสั่งหลอม (ทดลอง)", "Send Target Name With Forge Call (experimental)"),
        Desc  = LT("เปิดเฉพาะถ้าเกมรับพารามิเตอร์สูตร ถ้าหลอมไม่ออกให้ปิด", "Only if the game's forge takes a recipe argument; turn off if forging fails"),
        Value = State.ForgePassTarget,
        Callback = function(v) State.ForgePassTarget = v end,
    })

    local autoForgeToggle = toggleLoop("AutoForge", "ForgeDelay", runAutoForge)
    T6:Toggle({
        Title = T("Tgl_AutoForge"),
        Desc  = T("Desc_AutoForge"),
        Value = State.AutoForge,
        Callback = function(v)
            if v then ForgeState.baseline = nil end
            autoForgeToggle(v)
        end,
    })

    T6:Slider({
        Title = T("Sld_ForgeDelay"),
        Value = { Min = 0.3, Max = 5.0, Default = State.ForgeDelay },
        Callback = function(v) State.ForgeDelay = v end,
    })

    T6:Button({
        Title = T("Btn_ForgeOnce"),
        Callback = function()
            once("ForgeOnce", 0.5, function()
                local res = call("Forge", "ForgeRF")
                notify("Forge", "Result: " .. tostring(resultString(res, 0)), "hammer")
            end)
        end,
    })

    T6:Section({ Title = T("Sec_Enhance") })

    T6:Toggle({
        Title = T("Tgl_EquipBest"),
        Desc  = T("Desc_EquipBest"),
        Value = State.AutoEquipBest,
        Callback = toggleLoop("AutoEquipBest", 3.0, function()
            call("Backpack", "TryEquipItemRE")
        end),
    })

    T6:Toggle({
        Title = T("Tgl_AutoEnhance"),
        Desc  = T("Desc_AutoEnhance"),
        Value = State.AutoEnhance,
        Callback = toggleLoop("AutoEnhance", "EnhanceDelay", function()
            call("Backpack", "EnhantEquipmentRF")
        end),
    })

    T6:Toggle({
        Title = T("Tgl_AutoEnchant"),
        Value = State.AutoEnchant,
        Callback = toggleLoop("AutoEnchant", "EnchantDelay", function()
            call("Backpack", "EnchantRE")
        end),
    })

    T6:Button({
        Title = T("Btn_UnequipAll"),
        Callback = function()
            call("Backpack", "TryUnEquipItemRE")
            call("Backpack", "UnEnchantRE")
            notify(State.Language == "TH" and "คลังอุปกรณ์" or "Inventory", State.Language == "TH" and "ถอดอุปกรณ์และล้างอักขระเรียบร้อย" or "Unequipped items and stripped enchants", "trash-2")
        end,
    })

    -- ═════════════════════════════════════════════════════════════
    --  TAB 7: Class, Pets & Potions (Gacha & Buffs)
    -- ═════════════════════════════════════════════════════════════
    local T7 = Window:Tab({ Title = T("Tab7"), Icon = "sparkles" })

    T7:Section({ Title = T("Sec_Class") })

    T7:Dropdown({
        Title = LT("เลือกคลาสที่ต้องการ (เลือกได้หลายคลาส)", "Target Class(es)"),
        Desc  = LT("สุ่มอัตโนมัติไปเรื่อยๆ จนกว่าจะได้คลาสใดคลาสหนึ่งที่เลือก แล้วล็อกและสวมใส่ให้", "Rolls automatically until any selected class is obtained, then locks and equips it"),
        Values = Dynamic.Classes,
        Multi = true,
        AllowNone = true,
        Value = State.TargetClasses,
        Callback = function(v)
            State.TargetClasses = type(v) == "table" and v or { v }
            if State.TargetClasses[1] then State.TargetClassToLock = State.TargetClasses[1] end
        end,
    })

    T7:Toggle({
        Title = T("Tgl_RollClass"),
        Desc  = T("Desc_RollClass"),
        Value = State.AutoRollClass,
        Callback = toggleLoop("AutoRollClass", "RollClassDelay", runClassRoll),
    })

    T7:Slider({
        Title = T("Sld_RollClassDelay"),
        Value = { Min = 0.5, Max = 5.0, Default = State.RollClassDelay },
        Callback = function(v) State.RollClassDelay = v end,
    })

    T7:Toggle({
        Title = T("Tgl_RollSkills"),
        Desc  = T("Desc_RollSkills"),
        Value = State.AutoRollSkills,
        Callback = toggleLoop("AutoRollSkills", "RollSkillDelay", runSkillRoll),
    })

    T7:Section({ Title = T("Sec_Pets") })

    T7:Toggle({
        Title = T("Tgl_AutoPotions"),
        Desc  = T("Desc_AutoPotions"),
        Value = State.AutoUsePotions,
        Callback = toggleLoop("AutoUsePotions", "PotionDelay", runPotions),
    })

    T7:Toggle({
        Title = T("Tgl_AutoHatch"),
        Desc  = T("Desc_AutoHatch"),
        Value = State.AutoHatchEggs,
        Callback = toggleLoop("AutoHatchEggs", "HatchEggDelay", runHatch),
    })

    -- ═════════════════════════════════════════════════════════════
    --  TAB 8: Rewards & Promo Codes
    -- ═════════════════════════════════════════════════════════════
    local T8 = Window:Tab({ Title = T("Tab8"), Icon = "gift" })

    T8:Section({ Title = T("Sec_Rewards") })

    T8:Toggle({
        Title = T("Tgl_AutoClaim"),
        Desc  = T("Desc_AutoClaim"),
        Value = State.AutoClaimRewards,
        Callback = toggleLoop("AutoClaimRewards", "ClaimDelay", claimAllRewards),
    })

    T8:Slider({
        Title = T("Sld_ClaimDelay"),
        Value = { Min = 10, Max = 300, Default = State.ClaimDelay },
        Callback = function(v) State.ClaimDelay = v end,
    })

    T8:Button({
        Title = T("Btn_ClaimAllNow"),
        Callback = function()
            once("ClaimAllNow", 2.0, function()
                claimAllRewards()
                notify(State.Language == "TH" and "ของรางวัล" or "Rewards", State.Language == "TH" and "ส่งคำสั่งกดรับรางวัลทุกประเภทเรียบร้อย" or "Dispatched claim requests for all categories", "gift")
            end)
        end
    })

    T8:Section({ Title = T("Sec_Codes") })

    T8:Paragraph({
        Title = LT("ระบบหาโค้ดอัตโนมัติ", "Automatic Code Finder"),
        Desc  = LT("ระบบจะค้นหาโค้ดเองจากคอนฟิกของเกมและเว็บรวมโค้ด แล้วกรอกให้ทีละโค้ด ไม่ต้องพิมพ์เอง", "The script finds codes from the game config and code sites, then redeems them one by one"),
    })

    T8:Button({
        Title = LT("ค้นหาและกรอกโค้ดอัตโนมัติ", "Find & Redeem Codes Automatically"),
        Callback = function()
            once("AutoCodes", 3.0, function()
                notify(LT("โค้ด", "Codes"), LT("กำลังค้นหาโค้ด...", "Searching for codes..."), "search")
                redeemAllCodes()
            end)
        end,
    })

    T8:Toggle({
        Title = LT("ค้นหาและกรอกโค้ดอัตโนมัติทุกครั้งที่รันสคริปต์", "Auto Redeem Codes On Start"),
        Value = State.AutoRedeemOnStart,
        Callback = function(v) State.AutoRedeemOnStart = v end,
    })

    local codeInput = ""
    T8:Input({
        Title = LT("กรอกโค้ดเอง (ไม่บังคับ)", "Manual Code (optional)"),
        Placeholder = T("Input_Code"),
        Callback = function(t) codeInput = t end,
    })

    T8:Button({
        Title = T("Btn_SubmitCode"),
        Callback = function()
            if codeInput == "" then return notify("Codes", State.Language == "TH" and "กรุณากรอกรหัสโค้ดก่อนกดยืนยัน" or "Input code cannot be empty", "alert-triangle") end
            once("RedeemCode", 0.75, function()
                local res = call("Code", "TryUseCodeRF", codeInput)
                notify("Codes", "Server response: " .. tostring(resultString(res, 0)), "ticket")
            end)
        end,
    })

    -- ═════════════════════════════════════════════════════════════
    --  TAB 9: Teleports & Navigation
    -- ═════════════════════════════════════════════════════════════
    local T9 = Window:Tab({ Title = T("Tab9"), Icon = "map-pin" })

    T9:Section({ Title = T("Sec_Locations") })

    T9:Dropdown({
        Title = LT("เลือกจุดที่จะวาร์ปไป", "Warp Destination"),
        Desc  = LT("เลือกได้ทั้งโซนปลอดภัย ดันเจี้ยน พื้นที่ฝึก และด่านต่างๆ (ด่าน 1, ด่าน 2, ...)", "Safe zone, dungeon, train areas, or any stage (Stage 1, Stage 2, ...)"),
        Values = warpLabels(),
        Value = warpLabelForId(State.WarpTarget),
        Callback = function(v) State.WarpTarget = warpIdForLabel(v) end,
    })

    T9:Button({
        Title = LT("วาร์ปไปที่เลือก", "Warp Now"),
        Desc  = LT("ถ้าวาร์ปเข้าด่าน ให้ปิดฟาร์มอัตโนมัติก่อนเพื่อไม่ให้ระบบสลับด่านทับ", "When warping into a stage, turn farming off first so it does not switch stages"),
        Callback = function()
            once("WarpNow", 1.0, function()
                local ok = warpTo(State.WarpTarget)
                notify(
                    LT("วาร์ป", "Warp"),
                    ok and (LT("ไปที่: ", "Warped to: ") .. warpLabelForId(State.WarpTarget)) or LT("ไม่พบจุดหมายนี้ในแมพ", "Destination not found"),
                    ok and "map-pin" or "alert-triangle"
                )
            end)
        end,
    })

    T9:Button({
        Title = T("Btn_TpSafeZone"),
        Callback = function()
            tpTo(getSafeZoneCF())
            notify("Waypoint", State.Language == "TH" and "เดินทางถึงโซนปลอดภัยเรียบร้อย" or "Arrived at Safe Zone", "shield")
        end,
    })

    local savedPosition = nil
    T9:Button({
        Title = T("Btn_SavePos"),
        Callback = function()
            local r = hrp()
            if r then
                savedPosition = r.CFrame
                notify("Waypoint", State.Language == "TH" and "บันทึกพิกัดตำแหน่งปัจจุบันแล้ว" or "Coordinates saved", "check")
            end
        end,
    })

    T9:Button({
        Title = T("Btn_LoadPos"),
        Callback = function()
            if savedPosition then
                tpTo(savedPosition)
                notify("Waypoint", State.Language == "TH" and "วาร์ปกลับสู่ตำแหน่งที่บันทึกไว้แล้ว" or "Returned to saved coordinates", "map-pin")
            else
                notify("Waypoint", State.Language == "TH" and "ยังไม่มีการบันทึกพิกัดตำแหน่ง" or "No saved coordinates found", "alert-triangle")
            end
        end,
    })

    T9:Section({ Title = T("Sec_Server") })

    T9:Button({
        Title = T("Btn_Rejoin"),
        Callback = function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end,
    })

    T9:Button({
        Title = T("Btn_ServerHop"),
        Callback = function()
            local ok, data = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(
                    ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
                ))
            end)
            if ok and data and data.data then
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        notify("Server Hop", State.Language == "TH" and "กำลังเชื่อมต่อเข้าเซิร์ฟเวอร์ใหม่..." or "Connecting to new server instance...", "server")
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        return
                    end
                end
            end
            notify("Server Hop", State.Language == "TH" and "ไม่พบเซิร์ฟเวอร์อื่นที่เหมาะสม" or "No alternative server found", "alert-triangle")
        end,
    })

    T9:Button({
        Title = T("Btn_CopyJobId"),
        Desc  = tostring(game.JobId),
        Callback = function()
            if setclipboard then
                setclipboard(game.JobId)
                notify("JobId", State.Language == "TH" and "คัดลอกรหัสเซิร์ฟเวอร์ลงคลิปบอร์ดแล้ว" or "Copied JobId to clipboard", "copy")
            end
        end,
    })

    -- ═════════════════════════════════════════════════════════════
    --  TAB 10: Webhook & Settings (Profile & Performance)
    -- ═════════════════════════════════════════════════════════════
    local T10 = Window:Tab({ Title = T("Tab10"), Icon = "settings" })

    T10:Section({ Title = T("Sec_Interface") })

    T10:Dropdown({
        Title = T("Drop_Language"),
        Desc  = T("Desc_Language"),
        Values = { "ไทย (Thai)", "English (EN)" },
        Value = (State.Language == "EN" and "English (EN)" or "ไทย (Thai)"),
        Callback = function(v)
            local newLang = (v:find("English") or v:find("EN")) and "EN" or "TH"
            if State.Language ~= newLang then
                State.Language = newLang
                notify(
                    newLang == "TH" and "เปลี่ยนภาษา" or "Language",
                    newLang == "TH" and "เปลี่ยนภาษาเป็น ภาษาไทย เรียบร้อยแล้ว" or "Language switched to English",
                    "globe"
                )
                task.delay(0.35, function()
                    BuildingUI = false
                    BuildUI()
                    startLoops()
                end)
            end
        end,
    })

    local themeList = {}
    for _, n in ipairs(ThemeOrder) do table.insert(themeList, n) end
    table.insert(themeList, "Dark")
    table.insert(themeList, "Light")

    T10:Dropdown({
        Title = T("Drop_Theme"),
        Desc  = LT("เลือกได้ " .. #themeList .. " ธีม", #themeList .. " themes available"),
        Values = themeList,
        Value = startTheme,
        Callback = function(o)
            State.Theme = o
            pcall(function() WindUI:SetTheme(o) end)
        end,
    })

    T10:Toggle({
        Title = T("Tgl_Transparency"),
        Desc  = LT("เปิดไว้เป็นค่าเริ่มต้น ปิดเองได้ตรงนี้", "On by default; turn it off here"),
        Value = State.Transparency,
        Callback = function(v)
            State.Transparency = v
            pcall(function() Window:ToggleTransparency(v) end)
        end,
    })

    T10:Section({ Title = T("Sec_Webhook") })

    T10:Toggle({
        Title = T("Tgl_Webhook"),
        Value = State.WebhookEnabled,
        Callback = function(v) State.WebhookEnabled = v end,
    })

    T10:Input({
        Title = State.Language == "TH" and "ลิงก์ Discord Webhook URL" or "Discord Webhook URL",
        Placeholder = T("Input_Webhook"),
        Value = State.WebhookUrl,
        Callback = function(t) State.WebhookUrl = t end,
    })

    T10:Toggle({
        Title = T("Tgl_NotifyRare"),
        Value = State.NotifyRareDrops,
        Callback = function(v) State.NotifyRareDrops = v end,
    })

    T10:Toggle({
        Title = T("Tgl_NotifyHourly"),
        Value = State.NotifyHourlyReport,
        Callback = function(v) State.NotifyHourlyReport = v end,
    })

    T10:Toggle({
        Title = T("Tgl_NotifyRebirth"),
        Value = State.NotifyRebirth,
        Callback = function(v) State.NotifyRebirth = v end,
    })

    T10:Button({
        Title = T("Btn_TestWebhook"),
        Callback = function()
            if not State.WebhookUrl or State.WebhookUrl == "" then
                return notify("Webhook", State.Language == "TH" and "ยังไม่ได้ตั้งค่า Webhook URL" or "Webhook URL not configured", "alert-triangle")
            end
            local isTH = State.Language == "TH"
            sendWebhook(
                isTH and "ทดสอบการส่งข้อความ Webhook" or "Aetherix Hub Webhook Test",
                isTH and "เชื่อมต่อระบบส่งข้อมูลสำเร็จพร้อมทำงานตลอด 24 ชั่วโมง" or "Communication link established successfully.",
                {
                    { name = isTH and "ชื่อผู้เล่น" or "Player", value = LocalPlayer.Name, inline = true },
                    { name = isTH and "เวอร์ชันระบบ" or "Engine", value = "v3.3 PRO", inline = true },
                },
                0x10B981
            )
            notify("Webhook", State.Language == "TH" and "ส่งข้อความทดสอบไปยัง Discord เรียบร้อย" or "Dispatched test payload", "send")
        end,
    })

    T10:Section({ Title = T("Sec_Player") })

    T10:Slider({
        Title = T("Sld_WalkSpeed"),
        Desc  = LT("ค่าเริ่มต้น 16 ทุกครั้งที่รัน (เว้นแต่โหลดโปรไฟล์)", "Defaults to 16 on every run unless a profile is loaded"),
        Value = { Min = 16, Max = 250, Default = State.WalkSpeed },
        Callback = function(v)
            State.WalkSpeed = v
            PlayerModsTouched = true
            local h = hum()
            if h then h.WalkSpeed = v end
        end,
    })

    T10:Slider({
        Title = T("Sld_JumpPower"),
        Desc  = LT("ค่าเริ่มต้น 50 ทุกครั้งที่รัน (เว้นแต่โหลดโปรไฟล์)", "Defaults to 50 on every run unless a profile is loaded"),
        Value = { Min = 50, Max = 300, Default = State.JumpPower },
        Callback = function(v)
            State.JumpPower = v
            PlayerModsTouched = true
            local h = hum()
            if h then
                h.UseJumpPower = true
                h.JumpPower = v
            end
        end,
    })

    T10:Toggle({ Title = T("Tgl_InfJump"), Value = State.InfJump, Callback = function(v) State.InfJump = v end })
    T10:Toggle({ Title = T("Tgl_Noclip"), Value = State.Noclip, Callback = function(v) State.Noclip = v end })
    T10:Toggle({ Title = T("Tgl_AntiAFK"), Value = State.AntiAFK, Callback = function(v) State.AntiAFK = v end })

    T10:Section({ Title = T("Sec_Optimize") })

    T10:Toggle({
        Title = T("Tgl_CpuSaver"),
        Value = State.CpuSaver,
        Callback = function(v)
            State.CpuSaver = v
            applyCpuSaver()
            notify(
                State.Language == "TH" and "ระบบประหยัดพลังงาน" or "Optimizer",
                v and (State.Language == "TH" and "ปิดการแสดงภาพ 3D (จำกัด 15 FPS เรียบร้อย)" or "3D Rendering disabled (15 FPS mode active)") or (State.Language == "TH" and "เปิดการแสดงภาพ 3D ปกติแล้ว" or "3D Rendering restored"),
                "zap"
            )
        end,
    })

    -- ─── Config Profiles (บันทึกหลายชุด ตั้งชื่อได้ เลือกโหลดได้) ───
    T10:Section({ Title = T("Sec_Config") })

    local noneLabel = LT("(ยังไม่มีที่บันทึกไว้)", "(none saved)")
    local pendingName = State.CurrentProfile
    local selectedProfile = State.CurrentProfile

    local function profileValues()
        local l = listProfiles()
        if #l == 0 then l = { noneLabel } end
        return l
    end

    T10:Paragraph({
        Title = LT("โปรไฟล์ปัจจุบัน", "Current Profile"),
        Desc  = State.CurrentProfile ~= "" and State.CurrentProfile or LT("ยังไม่ได้ตั้งชื่อ (ใช้ค่าเริ่มต้น)", "Unnamed (defaults)"),
    })

    T10:Input({
        Title = LT("ตั้งชื่อการตั้งค่า", "Profile Name"),
        Placeholder = LT("พิมพ์ชื่อ เช่น ฟาร์มดันเจี้ยน", "e.g. Dungeon Farm"),
        Value = State.CurrentProfile,
        Callback = function(t) pendingName = t end,
    })

    local profileList = profileValues()
    local profileDD = T10:Dropdown({
        Title = LT("เลือกการตั้งค่าที่บันทึกไว้", "Saved Profiles"),
        Values = profileList,
        Value = (State.CurrentProfile ~= "" and table.find(profileList, State.CurrentProfile)) and State.CurrentProfile or profileList[1],
        Callback = function(v) selectedProfile = v end,
    })

    local function refreshProfiles()
        pcall(function() profileDD:Refresh(profileValues()) end)
    end

    T10:Button({
        Title = T("Btn_SaveConfig"),
        Desc  = LT("บันทึกตามชื่อที่ตั้งไว้ด้านบน (ถ้าไม่ตั้งชื่อ จะทับโปรไฟล์ปัจจุบัน)", "Saves under the name above (overwrites the current profile if blank)"),
        Callback = function()
            local ok, res = saveProfile(pendingName)
            if ok then
                selectedProfile = res
                refreshProfiles()
                notify("Config", T("Notif_ConfigSaved") .. " (" .. tostring(res) .. ")", "save")
            else
                notify("Config", LT("บันทึกไม่สำเร็จ (executor ไม่รองรับ writefile หรือเขียนไฟล์ไม่ได้)", "Save failed (executor has no file access)"), "alert-triangle")
            end
        end,
    })

    T10:Button({
        Title = T("Btn_LoadConfig"),
        Desc  = LT("โหลดโปรไฟล์ที่เลือกในรายการ (รีเซ็ตทุกอย่างก่อนแล้วค่อยใส่ค่าที่บันทึก)", "Loads the selected profile (resets everything first)"),
        Callback = function()
            if selectedProfile == "" or selectedProfile == noneLabel then
                return notify("Config", LT("ยังไม่ได้เลือกโปรไฟล์", "No profile selected"), "alert-triangle")
            end
            if loadProfile(selectedProfile) then
                notify("Config", T("Notif_ConfigLoaded") .. " (" .. selectedProfile .. ")", "folder")
                task.delay(0.35, function()
                    applyCpuSaver()
                    BuildingUI = false
                    BuildUI()
                    startLoops()
                    applyPlayerMods()
                    maintainGodMode()
                end)
            else
                notify("Config", LT("ไม่พบไฟล์บันทึกหรือไฟล์เสีย", "Profile not found or corrupted"), "alert-triangle")
            end
        end,
    })

    T10:Button({
        Title = LT("ลบโปรไฟล์ที่เลือก", "Delete Selected Profile"),
        Callback = function()
            if selectedProfile == "" or selectedProfile == noneLabel then return end
            if deleteProfile(selectedProfile) then
                notify("Config", LT("ลบโปรไฟล์แล้ว: ", "Deleted: ") .. selectedProfile, "trash-2")
                selectedProfile = ""
                refreshProfiles()
            else
                notify("Config", LT("ลบไม่สำเร็จ", "Delete failed"), "alert-triangle")
            end
        end,
    })

    T10:Button({
        Title = LT("รีเฟรชรายการโปรไฟล์", "Refresh Profile List"),
        Callback = refreshProfiles,
    })

    T10:Toggle({
        Title = T("Tgl_AutoSave"),
        Desc  = LT("บันทึกลงโปรไฟล์ปัจจุบันอัตโนมัติทุกครั้งที่มีการเปลี่ยนแปลง (ต้องบันทึกโปรไฟล์ครั้งแรกก่อน)", "Autosaves into the current profile on every change (save a profile once first)"),
        Value = State.AutoSaveConfig,
        Callback = function(v) State.AutoSaveConfig = v end,
    })

    T10:Toggle({
        Title = LT("โหลดโปรไฟล์ล่าสุดอัตโนมัติตอนรันสคริปต์", "Auto-Load Last Profile On Start"),
        Desc  = LT("ปิดแล้วจะเริ่มด้วยค่าเริ่มต้นทั้งหมดทุกครั้ง", "When off, every run starts from pure defaults"),
        Value = State.AutoLoadLast,
        Callback = function(v) State.AutoLoadLast = v end,
    })

    T10:Button({
        Title = T("Btn_DestroyUI"),
        Callback = function()
            Shutdown()
        end,
    })

    Window:SelectTab(1)
    BuildingUI = false
end

-- ─────────────────────────────────────────────────────────────
-- Event Listeners & Hardware Simulation (ทุกตัวถูก track เพื่อล้างตอนรันซ้ำ)
-- ─────────────────────────────────────────────────────────────
track(LocalPlayer.CharacterAdded:Connect(function(c)
    local h = c:WaitForChild("Humanoid", 8)
    if h and (State.WalkSpeed ~= 16 or State.JumpPower ~= 50 or PlayerModsTouched) then
        h.WalkSpeed = State.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower = State.JumpPower
    end
    if State.GodMode then
        task.wait(0.5)
        maintainGodMode()
    end
end))

track(UserInputService.JumpRequest:Connect(function()
    if Alive and State.InfJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

local LastNoclipTick = 0
track(RunService.Stepped:Connect(function()
    if not Alive then return end
    local now = os.clock()

    if State.Noclip and now - LastNoclipTick >= 0.10 then
        LastNoclipTick = now
        local c = char()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
    end

    if State.GodMode then
        maintainGodMode()
    end
end))

track(LocalPlayer.Idled:Connect(function()
    if Alive and State.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end))

track(GuiService.ErrorMessageChanged:Connect(function()
    if Alive and (State.Master247 or State.AutoDungeon or State.AutoStage) then
        task.wait(3)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end))

-- ─────────────────────────────────────────────────────────────
-- Shutdown (ใช้ตอนกดปิดสคริปต์ และตอนรันสคริปต์ซ้ำ)
-- ─────────────────────────────────────────────────────────────
Shutdown = function()
    Alive = false
    for k, v in pairs(State) do
        if type(v) == "boolean" then State[k] = false end
    end
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    pcall(function()
        local h = hum()
        if h and PlayerModsTouched then
            h.WalkSpeed = 16
            h.UseJumpPower = true
            h.JumpPower = 50
        end
    end)
    pcall(function()
        if CurrentWindow then CurrentWindow:Destroy() end
    end)
    if GENV.__AETHERIX_SHUTDOWN == Shutdown then GENV.__AETHERIX_SHUTDOWN = nil end
end
GENV.__AETHERIX_SHUTDOWN = Shutdown

-- ─────────────────────────────────────────────────────────────
-- Background Worker Threads
-- ─────────────────────────────────────────────────────────────
task.spawn(function()
    while Alive do
        if State.Master247 then
            pcall(runMaster247Engine)
        end
        task.wait(0.2)
    end
end)

-- บันทึกอัตโนมัติลงโปรไฟล์ปัจจุบันเมื่อมีการเปลี่ยนแปลงใดๆ
task.spawn(function()
    while Alive do
        task.wait(2)
        if Alive and State.AutoSaveConfig and State.CurrentProfile ~= "" and fsReady() then
            local encoded = encodeState()
            if encoded and encoded ~= LastSavedJSON then
                local ok = pcall(function() writefile(profilePath(State.CurrentProfile), encoded) end)
                if ok then LastSavedJSON = encoded end
            end
        end
    end
end)

task.spawn(function()
    while Alive do
        pcall(function()
            local elapsed = os.time() - Stats.StartTime
            local h = math.floor(elapsed / 3600)
            local m = math.floor((elapsed % 3600) / 60)
            local s = elapsed % 60
            local timeStr = ("%02d:%02d:%02d"):format(h, m, s)

            local curBag, maxBag = getPackInfo()
            local hPart = hum()
            local curHp = hPart and math.floor(hPart.Health) or 100
            local maxHp = hPart and math.floor(hPart.MaxHealth) or 100

            local isTH = State.Language == "TH"

            if StatusCard then
                local actText = Stats.CurrentActivity
                if Locales[State.Language] and Locales[State.Language][actText] then
                    actText = Locales[State.Language][actText]
                elseif Locales.TH[actText] then
                    actText = Locales.TH[actText]
                end
                StatusCard:SetDesc((isTH and "สถานะ: " or "Status: ") .. tostring(actText))
            end

            if StatsCard then
                if isTH then
                    StatsCard:SetDesc(
                        ("เวลาที่เปิดบอท: %s\nแร่ที่เก็บได้: %d\nรอบที่ขายของ: %d\nมอนสเตอร์ที่กำจัด: %d\nจำนวนเกิดใหม่: %d\nบอสยักษ์ที่จัดการ: %d")
                        :format(timeStr, Stats.OresCollected, Stats.SellCycles, Stats.Kills, Stats.RebirthCount, Stats.SuperLootKills)
                    )
                else
                    StatsCard:SetDesc(
                        ("Elapsed Time: %s\nOres Collected: %d\nSales Executed: %d\nMonsters Defeated: %d\nRebirths: %d\nSuper Loot Defeated: %d")
                        :format(timeStr, Stats.OresCollected, Stats.SellCycles, Stats.Kills, Stats.RebirthCount, Stats.SuperLootKills)
                    )
                end
            end

            if BagCard then
                if isTH then
                    BagCard:SetDesc(
                        ("ความจุสัมภาระ: %d / %d (%d%%)\nพลังชีวิต: %d / %d (%d%%)")
                        :format(curBag, maxBag, math.floor((curBag / math.max(maxBag, 1)) * 100), curHp, maxHp, math.floor((curHp / math.max(maxHp, 1)) * 100))
                    )
                else
                    BagCard:SetDesc(
                        ("Backpack: %d / %d (%d%%)\nHealth: %d / %d (%d%%)")
                        :format(curBag, maxBag, math.floor((curBag / math.max(maxBag, 1)) * 100), curHp, maxHp, math.floor((curHp / math.max(maxHp, 1)) * 100))
                    )
                end
            end

            -- Hourly Webhook Telemetry
            if State.WebhookEnabled and State.NotifyHourlyReport and (os.time() - Stats.LastHourlyPost >= 3600) then
                Stats.LastHourlyPost = os.time()
                sendWebhook(
                    isTH and "รายงานสถิติการฟาร์ม 24/7 (รายชั่วโมง)" or "Hourly 24/7 Farm Telemetry",
                    isTH and "สรุปผลการทำงานของระบบฟาร์มอัตโนมัติ" or "Status report for active farming session.",
                    {
                        { name = isTH and "เวลาที่เปิดทำงาน" or "Elapsed Time", value = timeStr, inline = true },
                        { name = isTH and "แร่ที่เก็บได้" or "Ores Collected", value = tostring(Stats.OresCollected), inline = true },
                        { name = isTH and "มอนสเตอร์ที่กำจัด" or "Monsters Defeated", value = tostring(Stats.Kills), inline = true },
                        { name = isTH and "รอบการขาย" or "Sales Executed", value = tostring(Stats.SellCycles), inline = true },
                        { name = isTH and "บอสยักษ์ที่จัดการ" or "Super Loot Defeated", value = tostring(Stats.SuperLootKills), inline = true },
                        { name = isTH and "จำนวนเกิดใหม่" or "Rebirths", value = tostring(Stats.RebirthCount), inline = true },
                        { name = isTH and "สถานะปัจจุบัน" or "Current Activity", value = tostring(Stats.CurrentActivity), inline = false },
                    },
                    0x8B5CF6
                )
            end
        end)
        task.wait(1)
    end
end)

-- ─────────────────────────────────────────────────────────────
-- Launch (รีเซ็ตทุกอย่าง -> โหลดโปรไฟล์ล่าสุด -> อมตะเปิดเสมอ)
-- ─────────────────────────────────────────────────────────────
local loadedProfile = false
if State.AutoLoadLast then
    loadedProfile = loadLastProfile()
end
Title = LT("ดูข้อมูลสูตรของไอเทมเป้าหมาย", "Show Target Recipe Data"),
        Callback = function()
            local text = refreshForgeInfo()
            print("[Aetherix Forge] sources:", #Dynamic.ForgeSources, "items:", #Dynamic.ForgeItems)
            for _, src in ipairs(Dynamic.ForgeSources) do
                print("[Aetherix Forge] config folder:", src.name)
            end
            if text then print("[Aetherix Forge] recipe:", text) end
            notify(LT("ข้อมูลสูตร", "Recipe"), text and text:sub(1, 180) or LT("ไม่พบข้อมูลสูตร (ดู Console)", "No recipe data (see console)"), "book-open")
        end,
    })

    T6:Slider({
        Title = LT("จำนวนครั้งสูงสุดที่จะหลอมหาไอเทม", "Max Forge Attempts"),
        Value = { Min = 10, Max = 2000, Default = State.ForgeMaxTries },
        Callback = function(v) State.ForgeMaxTries = v end,
    })

    T6:Toggle({
        Title = LT("ส่งชื่อไอเทมเป้าหมายไปกับคำสั่งหลอม (ทดลอง)", "Send Target Name With Forge Call (experimental)"),
        Desc  = LT("เปิดเฉพาะถ้าเกมรับพารามิเตอร์สูตร ถ้าหลอมไม่ออกให้ปิด", "Only if the game's forge takes a recipe argument; turn off if forging fails"),
        Value = State.ForgePassTarget,
        Callback = function(v) State.ForgePassTarget = v end,
    })

    local autoForgeToggle = toggleLoop("AutoForge", "ForgeDelay", runAutoForge)
    T6:Toggle({
        Title = T("Tgl_AutoForge"),
        Desc  = T("Desc_AutoForge"),
        Value = State.AutoForge,
