-- ─────────────────────────────────────────────────────────────
-- Single-Instance Guard (รันซ้ำแล้วต้องล้างของเก่าทั้งหมดก่อน)
-- ─────────────────────────────────────────────────────────────
local GENV = (getgenv and getgenv()) or _G
if GENV.__AETHERIX_SHUTDOWN then
    pcall(GENV.__AETHERIX_SHUTDOWN)
    GENV.__AETHERIX_SHUTDOWN = nil
    task.wait(0.4)
end

local Alive = true
local Connections = {}
local function track(conn)
    table.insert(Connections, conn)
    return conn
end

-- ─────────────────────────────────────────────────────────────
-- UI Runtime State
-- ─────────────────────────────────────────────────────────────
local CurrentWindUI = nil
local CurrentWindow = nil
local function notify(title, content, icon)
    if CurrentWindUI then
        pcall(function()
            CurrentWindUI:Notify({ Title = title, Content = content, Icon = icon or "bell", Duration = 3 })
        end)
    end
end

-- ─────────────────────────────────────────────────────────────
-- Services
-- ─────────────────────────────────────────────────────────────
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local VirtualUser       = game:GetService("VirtualUser")
local TeleportService   = game:GetService("TeleportService")
local HttpService       = game:GetService("HttpService")
local GuiService        = game:GetService("GuiService")

local LocalPlayer = Players.LocalPlayer
local RemoteRoot  = ReplicatedStorage:WaitForChild("Remote", 15)

-- ─────────────────────────────────────────────────────────────
-- Dynamic Game Asset Discovery (Auto-updates with game patches)
-- ─────────────────────────────────────────────────────────────
local Dynamic = {
    Stages          = {},
    TrainAreas      = {},
    Classes         = {},
    Potions         = {},
    SuperLootTiers  = { "All", "Legendary", "Eternal", "Secret" },
}

pcall(function()
    local sh = require(ReplicatedStorage.Config.Stage.Helper)
    for k in pairs(sh.GetStageEnemyConfig()) do
        table.insert(Dynamic.Stages, k)
    end
    table.sort(Dynamic.Stages, function(a, b)
        local n1 = tonumber(a:match("%d+")) or 0
        local n2 = tonumber(b:match("%d+")) or 0
        return n1 < n2
    end)
end)
if #Dynamic.Stages == 0 then
    for i = 1, 30 do table.insert(Dynamic.Stages, "Stage_" .. i) end
end

pcall(function()
    local tah = require(ReplicatedStorage.Config.TrainArea.Helper)
    local count = 0
    for _ in pairs(tah.GetConfig()) do count = count + 1 end
    for i = 1, count do table.insert(Dynamic.TrainAreas, tostring(i)) end
end)
if #Dynamic.TrainAreas == 0 then
    for i = 1, 15 do table.insert(Dynamic.TrainAreas, tostring(i)) end
end

pcall(function()
    local ch = require(ReplicatedStorage.Config.Class.Helper)
    for k in pairs(ch.GetConfig()) do
        table.insert(Dynamic.Classes, k)
    end
    table.sort(Dynamic.Classes, function(a, b)
        local n1 = tonumber(a:match("%d+")) or 0
        local n2 = tonumber(b:match("%d+")) or 0
        return n1 < n2
    end)
end)
if #Dynamic.Classes == 0 then
    for i = 1, 9 do table.insert(Dynamic.Classes, "Class_" .. i) end
end

pcall(function()
    local ph = require(ReplicatedStorage.Config.Potion.Helper)
    for k in pairs(ph.GetConfig()) do
        table.insert(Dynamic.Potions, k)
    end
end)
if #Dynamic.Potions == 0 then
    Dynamic.Potions = { "DamagePotion", "TrainPotion", "CoinPotion", "LuckPotion", "HPPotion" }
end

pcall(function()
    local slh = require(ReplicatedStorage.Config.SuperLoot.Helper)
    for k in pairs(slh.GetConfig()) do
        if not table.find(Dynamic.SuperLootTiers, k) then
            table.insert(Dynamic.SuperLootTiers, k)
        end
    end
end)


-- ─────────────────────────────────────────────────────────────
-- Extra Discovery (v3.3): Ores / Forge items / Promo codes
-- ค้นหาข้อมูลจากคอนฟิกของเกมโดยตรง ถ้าไม่เจอจะใช้ค่าสำรอง
-- ─────────────────────────────────────────────────────────────
Dynamic.Rarities     = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Eternal", "Secret", "Ancient", "Infinite" }
Dynamic.OreOptions   = {}
Dynamic.ForgeItems   = {}
Dynamic.ForgeSources = {}
Dynamic.GameCodes    = {}

local function requireNode(node)
    if not node then return nil end
    if node:IsA("ModuleScript") then
        local ok, m = pcall(require, node)
        return ok and m or nil
    end
    local helper = node:FindFirstChild("Helper")
    if helper and helper:IsA("ModuleScript") then
        local ok, m = pcall(require, helper)
        return ok and m or nil
    end
    return nil
end

local function configTable(mod)
    if type(mod) ~= "table" then return nil end
    for _, fn in ipairs({ "GetConfig", "GetAllConfig", "GetAll", "GetList" }) do
        if type(mod[fn]) == "function" then
            local ok, r = pcall(mod[fn])
            if ok and type(r) == "table" then return r end
        end
    end
    return mod
end

local function keysOf(t)
    local out = {}
    if type(t) ~= "table" then return out end
    for k, v in pairs(t) do
        if type(k) == "string" and type(v) ~= "function" then
            table.insert(out, k)
        elseif type(k) == "number" and type(v) == "table" then
            local id = v.ID or v.Id or v.id or v.Name
            if type(id) == "string" then table.insert(out, id) end
        end
    end
    table.sort(out)
    return out
end

local function discoverConfigs(patterns)
    local found = {}
    local root = ReplicatedStorage:FindFirstChild("Config")
    if not root then return found end
    for _, child in ipairs(root:GetChildren()) do
        local ln = child.Name:lower()
        for _, p in ipairs(patterns) do
            if ln:find(p, 1, true) then
                local cfg = configTable(requireNode(child))
                if cfg then table.insert(found, { name = child.Name, cfg = cfg }) end
                break
            end
        end
    end
    return found
end

local function pushUnique(list, seen, v, cap)
    if cap and #list >= cap then return end
    if not seen[v] then
        seen[v] = true
        table.insert(list, v)
    end
end

pcall(function()
    local seen = {}
    Dynamic.ForgeSources = discoverConfigs({ "forge", "equip", "weapon", "gear", "recipe" })
    for _, src in ipairs(Dynamic.ForgeSources) do
        for _, k in ipairs(keysOf(src.cfg)) do pushUnique(Dynamic.ForgeItems, seen, k, 150) end
    end
end)

pcall(function()
    local seen = {}
    for _, r in ipairs(Dynamic.Rarities) do pushUnique(Dynamic.OreOptions, seen, r) end
    for _, src in ipairs(discoverConfigs({ "ore", "material" })) do
        for _, k in ipairs(keysOf(src.cfg)) do pushUnique(Dynamic.OreOptions, seen, k, 60) end
    end
end)

pcall(function()
    for _, src in ipairs(discoverConfigs({ "code", "promo", "redeem" })) do
        for _, k in ipairs(keysOf(src.cfg)) do
            if k:match("^[%w_]+$") and #k >= 4 and #k <= 30 then table.insert(Dynamic.GameCodes, k) end
        end
    end
end)

if #Dynamic.ForgeItems == 0 then
    Dynamic.ForgeItems = { "Legendary", "Mythic", "Eternal", "Secret", "Ancient", "Infinite" }
    Dynamic.ForgeItemsAreFallback = true
end

